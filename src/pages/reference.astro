---
import { type CollectionKey, getCollection } from "astro:content";
import Countdown from "~/components/reference/Countdown.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPageCopy } from "~/utils/pages";
import { getNextUpgrade } from "~/utils/reference";

const copy = await getPageCopy("reference");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const size = async (c: CollectionKey) => (await getCollection(c)).length;
const next = await getNextUpgrade();

const sections = await Promise.all(
	(
		copy.sections as {
			href: string;
			title: string;
			text: string;
			collection?: CollectionKey;
		}[]
	).map(async (s) => ({
		...s,
		n: s.collection ? await size(s.collection) : undefined,
	})),
);
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    {next && <Countdown date={next.data.date} title={next.data.title} href={`/upgrades/${next.id}`} status={next.data.status} />}
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 mt-6">
      {
        sections.map((s) => (
          <li>
            <a class="wb-card wb-card-hover flex flex-col gap-2 p-5 h-full" href={s.href}>
              <span class="font-heading text-2xl font-extrabold tracking-tight">{s.title}</span>
              <span class="text-muted">{s.text}</span>
              {s.n ? <span class="mt-auto font-mono text-xs text-muted">{s.n} {copy.entries}</span> : null}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
