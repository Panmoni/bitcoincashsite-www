---
import Button from "~/components/ui/Button.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getBlogPermalink, getPermalink } from "~/utils/permalinks";

const metadata = { title: "Page not found", robots: { index: false } };

// The site drawn as the main chain, oldest block first. The last one is the tip.
const chain = [
	{ title: "Home", url: getPermalink("/") },
	{ title: "Why BCH", url: getPermalink("/bitcoin-cash") },
	{ title: "Get a wallet", url: getPermalink("/onboard") },
	{ title: "CashTokens", url: getPermalink("/cashtokens") },
	{ title: "Build on BCH", url: getPermalink("/build") },
	{ title: "Reference", url: getPermalink("/reference") },
	{ title: "Latest from the blog", url: getBlogPermalink() },
];
const depth = chain.length - 1;
---

<Layout metadata={metadata}>
  <section class="px-4 sm:px-6 pt-10 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-7xl mx-auto">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] items-end">
        <div>
          <span class="wb-chip bg-wb-pink">Error 404 · stale block</span>
          <h1 class="mt-4 font-heading text-[clamp(2.75rem,6vw,4.75rem)] font-extrabold leading-[1.1] tracking-[-0.045em]">
            This page got <mark class="bg-wb-pink text-on-accent px-[0.12em] rounded-[0.12em]">orphaned</mark>.
          </h1>
        </div>
        <p class="text-xl text-muted max-w-[46ch]">
          It sat on a branch the network dropped. The main chain kept going, and every block on it still works. Pick one
          and carry on.
        </p>
      </div>

      <figure class="wb-card mt-10 p-5 md:p-7" aria-label="The site drawn as a chain of blocks">
        <figcaption class="flex flex-wrap justify-between gap-3 font-mono text-xs font-bold uppercase tracking-wider">
          <span>Main chain · bchworks.com</span>
          <span class="text-muted">Tip: {depth} confirmations deep</span>
        </figcaption>
        <ol class="chain mt-6">
          {
            chain.map(({ title, url }, i) => {
              const tip = i === depth;
              const conf = depth - i;
              return (
                <>
                  <li class="blk" style={`--i:${i}`}>
                    <a
                      href={url}
                      class:list={[
                        'wb-card wb-card-hover flex flex-col gap-1 p-3 h-full',
                        { 'bg-wb-green text-on-accent': tip },
                      ]}
                    >
                      <span class:list={['font-mono text-xs font-bold', tip ? 'text-on-accent' : 'text-muted']}>
                        {tip ? 'tip' : `tip − ${conf}`}
                      </span>
                      <b class="font-heading text-lg leading-tight tracking-tight">{title}</b>
                      <span class:list={['mt-auto font-mono text-[11px]', tip ? 'text-on-accent' : 'text-muted']}>
                        {tip ? 'just mined' : `${conf} conf`}
                      </span>
                    </a>
                  </li>
                  {i === 1 && (
                    <li class="orphan" aria-label="The page you asked for, orphaned">
                      <span class="font-mono text-xs font-bold text-wb-pink">orphaned</span>
                      <b id="orphan-path" class="block mt-1 font-mono text-[13px] break-all">this page</b>
                      <span class="inline-block mt-2 font-mono text-[11px] font-bold border-2 border-line rounded-full px-2 bg-wb-pink text-on-accent">
                        0 conf
                      </span>
                    </li>
                  )}
                </>
              );
            })
          }
        </ol>
      </figure>
      <p class="mt-4 font-mono text-[13px] text-muted">
        Merchants wait for 6 or more blocks before they treat a large payment as final. This is why.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4">
        <Button variant="primary" href={getPermalink('/')} text="Back to the tip →" class="w-full sm:w-auto" />
        <Button href={getPermalink('/glossary')} text="Search the glossary" class="w-full sm:w-auto" />
      </div>
    </div>
  </section>
</Layout>

<script>
  // Put the path the visitor asked for on the orphaned block.
  const path = decodeURIComponent(location.pathname);
  const el = document.getElementById("orphan-path");
  if (el && path.length > 1) el.textContent = path.length > 48 ? `${path.slice(0, 47)}…` : path;
</script>

<style>
  /* Phones: a vertical chain on a rail, the orphan branching off to the right.
     Desktop: seven blocks in a row, the orphan hanging below block 2. */
  .chain {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-left: 24px;
    list-style: none;
    margin-bottom: 0;
  }
  .chain::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 12px;
    bottom: 12px;
    border-left: 2px solid rgb(var(--wb-line));
  }
  .blk {
    position: relative;
    animation: drop 0.4s calc(var(--i) * 0.06s) both;
  }
  .blk::before {
    content: "";
    position: absolute;
    left: -17px;
    top: 50%;
    width: 17px;
    border-top: 2px solid rgb(var(--wb-line));
  }
  .orphan {
    position: relative;
    margin-left: 40px;
    padding: 12px;
    border: 2px dashed rgb(var(--wb-line));
    border-radius: 14px;
    background: repeating-linear-gradient(-45deg, rgb(var(--wb-surface)) 0 8px, rgb(var(--wb-soft)) 8px 16px);
    transform: rotate(-2deg);
    animation: fall 0.9s 0.6s both;
  }
  .orphan::before {
    content: "";
    position: absolute;
    left: -59px;
    top: 50%;
    width: 57px;
    border-top: 2px dashed rgb(var(--wb-line));
  }
  @media (min-width: 1024px) {
    .chain {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 24px;
      padding-left: 0;
      padding-bottom: 140px;
    }
    .chain::before {
      display: none;
    }
    .blk {
      min-height: 112px;
    }
    .blk::before {
      display: none;
    }
    .blk:not(:last-of-type)::after {
      content: "";
      position: absolute;
      right: -26px;
      top: 50%;
      width: 24px;
      border-top: 2px solid rgb(var(--wb-line));
    }
    .orphan {
      position: absolute;
      left: calc((100% - 6 * 24px) / 7 + 24px);
      top: 148px;
      width: calc((100% - 6 * 24px) / 7);
      margin-left: 0;
      transform: rotate(-4deg);
    }
    .orphan::before {
      left: 30%;
      top: -38px;
      width: 0;
      height: 36px;
      border-top: 0;
      border-left: 2px dashed rgb(var(--wb-line));
    }
  }
  @keyframes drop {
    from { transform: translateY(-8px); }
  }
  @keyframes fall {
    from { transform: translateY(-40px) rotate(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .blk,
    .orphan {
      animation: none;
    }
  }
</style>
