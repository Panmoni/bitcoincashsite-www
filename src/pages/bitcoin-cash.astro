---
import CallToAction from "~/components/widgets/CallToAction.astro";
import FAQs from "~/components/widgets/FAQs.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPermalink } from "~/utils/permalinks";

const metadata = {
	title: "Why Bitcoin Cash? The case against BCH, answered",
	description:
		"The strongest objections to Bitcoin Cash (BCH), each answered, contested or conceded. Plus how BCH compares with Bitcoin, Ethereum and Solana, and which chain fits which job.",
};

type Verdict = "answered" | "contested" | "conceded";

const verdictLabel: Record<Verdict, string> = {
	answered: "Answered",
	contested: "Contested",
	conceded: "Conceded",
};

const verdictClass: Record<Verdict, string> = {
	answered: "bg-wb-green",
	contested: "bg-wb-yellow",
	conceded: "bg-wb-pink",
};

const objections: {
	claim: string;
	verdict: Verdict;
	answer: string;
	evidence?: string;
}[] = [
	{
		claim: "It's just a failed fork of Bitcoin.",
		verdict: "answered",
		answer:
			"It is a fork. It split from Bitcoin in 2017 to keep fees low, and it split again in 2018 (BSV) and 2020 (eCash). Since then the yearly upgrade process has shipped six upgrades on schedule, with no split. A failed chain doesn't keep shipping.",
		evidence: "See the upgrade record below",
	},
	{
		claim: "Fees are low only because nobody uses it.",
		verdict: "answered",
		answer:
			"Fees are priced per byte, not by auction. You pay for the bytes you send, about one satoshi each. The block size limit grows with sustained demand, so a busy day doesn't raise the price.",
		evidence: "226 bytes × 1 sat/byte = 226 sats ≈ $0.001",
	},
	{
		claim: "No smart contracts means no real apps.",
		verdict: "contested",
		answer:
			"BCH has contracts, called covenants. Each one is a lock on a coin that checks the spending transaction. It doesn't run as a global program. DEXs, stablecoins, hedging, crowdfunding and vaults are live today. One shared pool that thousands of people update at once is still harder to build.",
		evidence: "Since May 2026: loops and functions",
	},
	{
		claim: "Nobody uses it. The ecosystem is tiny.",
		verdict: "conceded",
		answer:
			"True. The ecosystem is small, liquidity is thin, and DeFi on BCH is measured in millions, not billions. We say so here because trust is worth more than hype.",
	},
	{
		claim: "It's less secure than Bitcoin.",
		verdict: "conceded",
		answer:
			"BCH uses the same SHA-256 proof of work, but with a small fraction of Bitcoin's hash rate. For large sums, wait for more confirmations.",
	},
	{
		claim: "Tokens on BCH are just another rug waiting to happen.",
		verdict: "answered",
		answer:
			"CashTokens sit inside the coins in your wallet. No token contract holds a balance for you, and there's no approve() to exploit, so a forgotten approval can't drain you. No admin can pause or upgrade your token.",
	},
	{
		claim: "Ten-minute blocks are too slow for payments.",
		verdict: "contested",
		answer:
			"The merchant sees your payment in seconds. If someone tries to spend the same coins twice, nodes relay a double-spend proof. Final settlement still takes about ten minutes, and Solana is faster.",
	},
	{
		claim: "Some foundation or insider controls it.",
		verdict: "answered",
		answer:
			"There is no company, foundation or treasury, and no token unlocks. Several independent teams maintain node software. Changes go through an open proposal process (CHIPs) and activate once node, wallet, exchange and app teams sign on.",
	},
	{
		claim: "It isn't private.",
		verdict: "conceded",
		answer:
			"Correct. Like Bitcoin, BCH is a transparent public ledger. Electron Cash offers an optional coin-mixing tool called CashFusion, but BCH is not private by default.",
	},
	{
		claim: "No USDT or USDC, so it's useless for dollars.",
		verdict: "contested",
		answer:
			"The big stablecoin issuers aren't on the BCH main chain, and that's a real gap. Stablecoin and hedging contracts built on BCH do exist and work today.",
	},
];

const tally = (v: Verdict) => objections.filter((o) => o.verdict === v).length;

const upgrades = [
	{
		year: "2021",
		what: "Unconfirmed chain limit removed; multiple OP_RETURN outputs.",
	},
	{ year: "2022", what: "Native introspection and 64-bit integers." },
	{ year: "2023", what: "CashTokens: native fungible tokens and NFTs." },
	{ year: "2024", what: "Adaptive block size limit that follows demand." },
	{ year: "2025", what: "Higher VM limits and big-number math." },
	{ year: "2026", what: "Loops, functions and pay-to-script outputs." },
];

const chains = ["Bitcoin Cash", "Bitcoin", "Ethereum", "Solana"];

const jobs = [
	{
		job: "Send $5 to family abroad",
		best: 0,
		why: "Under a cent, no account needed, and the recipient sees it in seconds.",
		also: "Solana is close on cost. Bitcoin and Ethereum fees can cost more than the gift when blocks are busy.",
	},
	{
		job: "Take payments at a shop counter",
		best: 0,
		why: "Flat per-byte fees you can quote in advance, plus double-spend alerts on unconfirmed payments.",
		also: "Solana settles faster. Far more shops take cards than any chain.",
	},
	{
		job: "Issue a token with no admin key",
		best: 0,
		why: "CashTokens live inside coins. There is no token contract to exploit and no owner who can pause it.",
		also: "Ethereum has far more wallets and exchanges that list tokens.",
	},
	{
		job: "Hold savings for ten years",
		best: 1,
		why: "Bitcoin has the most hash rate, the deepest liquidity and the longest track record.",
		also: "BCH has the same 21 million supply, but a much smaller security budget.",
	},
	{
		job: "Run one pool that thousands update at once",
		best: 2,
		why: "Global contracts with shared storage are what Ethereum was built for.",
		also: "BCH runs DEXs and other DeFi, but this design is harder on a coin model.",
	},
	{
		job: "Settle in under a second",
		best: 3,
		why: "Solana produces a block about every 0.4 seconds.",
		also: "BCH shows a payment in seconds but settles in about ten minutes.",
	},
	{
		job: "Hold USDT or USDC",
		best: 2,
		why: "The big stablecoin issuers live on Ethereum, Solana and other chains.",
		also: "BCH has its own stablecoin contracts, but not the major issuers.",
	},
];

const compareRows = [
	{
		label: "Typical fee",
		bch: "Under 1¢, flat per byte",
		btc: "Varies; spikes when blocks fill",
		eth: "Gas auction; varies with demand",
		sol: "Fractions of a cent, plus priority fees",
	},
	{
		label: "Block time",
		bch: "10 min (payments show in seconds)",
		btc: "10 min",
		eth: "12 s",
		sol: "~0.4 s",
	},
	{
		label: "Model",
		bch: "UTXO (coins)",
		btc: "UTXO (coins)",
		eth: "Accounts",
		sol: "Accounts",
	},
	{
		label: "Tokens",
		bch: "Native in the coin; no contract",
		btc: "Overlay protocols (Runes, Ordinals)",
		eth: "Smart contracts (ERC-20, approve)",
		sol: "Token program accounts",
	},
	{
		label: "Contracts",
		bch: "Covenants; no admin keys",
		btc: "Limited script",
		eth: "Full smart contracts; upgradeable proxies common",
		sol: "Programs; upgradeable by default",
	},
	{
		label: "Consensus",
		bch: "SHA-256 proof of work",
		btc: "SHA-256 proof of work",
		eth: "Proof of stake",
		sol: "Proof of stake",
	},
	{ label: "Privacy by default", bch: "No", btc: "No", eth: "No", sol: "No" },
	{
		label: "Ecosystem size",
		bch: "Small",
		btc: "Largest",
		eth: "Large",
		sol: "Large",
	},
];
---

<Layout metadata={metadata}>
  <!-- Header + scoreboard -->
  <section class="px-4 sm:px-6">
    <div class="max-w-7xl mx-auto pt-10 pb-12 md:pt-16 md:pb-16 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <span class="wb-chip">The skeptic's case</span>
        <h1 class="mt-5 mb-5 font-heading text-[clamp(2.75rem,6vw,5rem)] font-extrabold leading-[0.95] tracking-[-0.045em]">
          Why <mark class="bg-wb-green text-on-accent px-[0.12em] rounded-[0.12em] [box-decoration-break:clone]">Bitcoin Cash</mark>? Here's the case against.
        </h1>
        <p class="text-xl text-muted max-w-[58ch]">
          Bitcoin Cash (BCH) is Bitcoin that kept the peer-to-peer cash plan. Below are the strongest objections to it, with a straight answer to each. Some we win, some are still open, and some we concede.
        </p>
      </div>
      <div class="wb-card p-6 grid gap-4">
        <span class="wb-label">Scoreboard · tap to filter</span>
        <p class="font-heading text-5xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{objections.length} objections</p>
        <div class="grid grid-cols-3 gap-3" id="verdict-filter">
          {
            (Object.keys(verdictLabel) as Verdict[]).map((v) => (
              <button
                type="button"
                data-filter={v}
                aria-pressed="false"
                class={`${verdictClass[v]} text-on-accent border-2 border-line rounded-[10px] p-3 text-left grid gap-1 cursor-pointer aria-pressed:shadow-[inset_0_0_0_3px_rgb(var(--wb-line))]`}
              >
                <span class="font-mono text-2xl font-bold leading-none">{tally(v)}</span>
                <span class="font-mono text-[11px] font-bold uppercase tracking-wide">{verdictLabel[v]}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Objections -->
  <section id="objections" class="px-4 sm:px-6 pb-10 md:pb-14 scroll-mt-24">
    <ol class="max-w-7xl mx-auto grid gap-4" id="objection-list">
      {
        objections.map(({ claim, verdict, answer, evidence }, i) => (
          <li class="wb-card overflow-hidden grid md:grid-cols-[1fr_1.5fr]" data-verdict={verdict}>
            <div class="p-5 md:p-6 bg-page border-b-2 md:border-b-0 md:border-r-2 border-line grid gap-2 content-start">
              <span class="wb-label">Objection {i + 1}</span>
              <h2 class="font-heading text-2xl font-extrabold tracking-tight leading-tight">“{claim}”</h2>
            </div>
            <div class="p-5 md:p-6 grid gap-3 content-start">
              <span class={`${verdictClass[verdict]} text-on-accent justify-self-start font-mono text-[11px] font-bold uppercase tracking-wide border-2 border-line rounded-full px-2.5 py-1`}>
                {verdictLabel[verdict]}
              </span>
              <p class="text-[16px]">{answer}</p>
              {evidence && <p class="font-mono text-xs text-muted">{evidence}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Upgrade record -->
  <section id="reliability" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">“But is it reliable?”</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">Six upgrades. Six on time.</h2>
        </div>
        <p class="text-muted max-w-[46ch]">
          BCH upgrades once a year, on May 15. Each upgrade runs on the public chipnet testnet for six months first. Every one since 2021 has activated on schedule.
        </p>
      </div>
      <ol class="wb-card overflow-hidden grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
        {
          upgrades.map(({ year, what }) => (
            <li class="p-5 grid gap-2 content-start border-line [&:not(:first-child)]:border-t-2 lg:[&:not(:first-child)]:border-t-0 lg:[&:not(:first-child)]:border-l-2">
              <span class="font-mono text-2xl font-bold leading-none">{year}</span>
              <span class="justify-self-start font-mono text-[10px] font-bold uppercase border-2 border-line rounded-full px-2 py-0.5 bg-wb-green text-on-accent">May 15</span>
              <p class="text-sm text-muted">{what}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Chooser -->
  <section id="chooser" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">Chooser</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">Which chain fits your job?</h2>
        </div>
        <p class="text-muted max-w-[44ch]">Each chain wins somewhere. Pick a job to see which one fits. Sometimes it isn't BCH.</p>
      </div>
      <div class="wb-card overflow-hidden grid md:grid-cols-[1fr_1.4fr]">
        <div class="p-5 md:p-6 border-b-2 md:border-b-0 md:border-r-2 border-line">
          <span class="wb-label block mb-3">What are you trying to do?</span>
          <div class="grid gap-2" id="job-list">
            {
              jobs.map(({ job }, i) => (
                <button
                  type="button"
                  data-job={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class="text-left font-heading font-bold text-[15px] border-2 border-line rounded-[10px] px-4 py-3 bg-surface text-ink cursor-pointer aria-pressed:bg-ink aria-pressed:text-page"
                >
                  {job}
                </button>
              ))
            }
          </div>
        </div>
        <div class="p-5 md:p-6" aria-live="polite">
          {
            jobs.map(({ best, why, also }, i) => (
              <div data-answer={i} hidden={i !== 0} class="grid gap-4">
                <span class="wb-label">Best fit</span>
                <p class="font-heading text-4xl md:text-5xl font-extrabold leading-none tracking-[-0.03em] flex flex-wrap items-center gap-3">
                  {chains[best]}
                  {best !== 0 && <span class="wb-chip !bg-wb-pink">Not BCH</span>}
                </p>
                <p class="text-lg">{why}</p>
                <p class="text-muted">{also}</p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  {chains.map((c, k) => (
                    <div class={`border-2 border-line rounded-[10px] p-3 font-heading font-extrabold ${k === best ? 'bg-wb-green text-on-accent' : 'text-muted'}`}>{c}</div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section id="compare" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">Compare</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">BCH vs BTC vs ETH vs SOL.</h2>
        </div>
        <p class="text-muted max-w-[44ch]">
          BCH wins on cost and simple, predictable money. It loses on speed to finality and on ecosystem size.
        </p>
      </div>
      <div class="wb-card overflow-x-auto">
        <table class="w-full min-w-[720px] text-left text-[15px]">
          <thead class="bg-soft font-mono text-xs uppercase tracking-wider">
            <tr>
              <th scope="col" class="p-4"></th>
              <th scope="col" class="p-4 bg-wb-green text-on-accent">Bitcoin Cash</th>
              <th scope="col" class="p-4">Bitcoin</th>
              <th scope="col" class="p-4">Ethereum (L1)</th>
              <th scope="col" class="p-4">Solana</th>
            </tr>
          </thead>
          <tbody>
            {
              compareRows.map(({ label, bch, btc, eth, sol }) => (
                <tr class="border-t-2 border-line">
                  <th scope="row" class="p-4 font-mono text-xs font-bold uppercase tracking-wider">{label}</th>
                  <td class="p-4 font-bold">{bch}</td>
                  <td class="p-4 text-muted">{btc}</td>
                  <td class="p-4 text-muted">{eth}</td>
                  <td class="p-4 text-muted">{sol}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <FAQs
    title="More questions"
    subtitle="Short, straight answers."
    highlight=""
    items={[
      {
        title: 'What is Bitcoin Cash?',
        description:
          'Bitcoin Cash (BCH) is a proof-of-work cryptocurrency that split from Bitcoin in August 2017 to keep fees low by allowing bigger blocks. It shares Bitcoin’s history up to that point, its 21 million supply and its SHA-256 mining algorithm. Since then it has added native tokens (CashTokens) and programmable covenants.',
      },
      {
        title: 'How is BCH different from Bitcoin (BTC)?',
        description:
          'BTC chose to be digital gold and settle most everyday payments on other layers. BCH chose to stay usable as cash on the main chain, with fees under a cent. BCH has also shipped features BTC is still debating, such as covenants and transaction introspection, plus native tokens. BTC has far more hash rate, liquidity and adoption.',
      },
      {
        title: 'Is BCH a good investment?',
        description:
          'We don’t give investment advice. BCH’s supply is fixed, but its price is volatile and can fall a long way. Only hold what you can afford to lose, and keep the coins in a wallet you control.',
      },
      {
        title: 'Is my Bitcoin Cash wallet tied to my identity?',
        description:
          'Your wallet is controlled by your private key or recovery phrase, not by your name or ID. That also means nobody can recover your coins if you lose it. Back up your recovery phrase securely. Exchanges are a separate matter: most require identity checks.',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Grab a Wallet',
        href: getPermalink('/onboard'),
      },
      {
        text: 'Start Building',
        href: getPermalink('/build'),
      },
    ]}
  >
    <Fragment slot="title">Judge it yourself.</Fragment>

    <Fragment slot="subtitle">Send yourself a few cents of BCH. It takes minutes and costs almost nothing.</Fragment>
  </CallToAction>
</Layout>

<script>
  function initSteelman() {
    const filter = document.getElementById("verdict-filter");
    const items = document.querySelectorAll<HTMLElement>("#objection-list > li");
    filter?.querySelectorAll<HTMLButtonElement>("button").forEach((btn) => {
      btn.addEventListener("click", () => {
        const on = btn.getAttribute("aria-pressed") !== "true";
        filter.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", "false"));
        if (on) btn.setAttribute("aria-pressed", "true");
        items.forEach((li) => {
          li.hidden = on && li.dataset.verdict !== btn.dataset.filter;
        });
      });
    });

    const jobButtons = document.querySelectorAll<HTMLButtonElement>("#job-list button");
    const answers = document.querySelectorAll<HTMLElement>("[data-answer]");
    jobButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        jobButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        answers.forEach((a) => {
          a.hidden = a.dataset.answer !== btn.dataset.job;
        });
      });
    });
  }

  initSteelman();
  document.addEventListener("astro:after-swap", initSteelman);
</script>
