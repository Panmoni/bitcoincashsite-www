---
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPageCopy } from "~/utils/pages";
import { getProjectsByCategory } from "~/utils/projects";

const copy = await getPageCopy("cashtokens");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const devTools = await getProjectsByCategory("cashtokens:devtool");
const wallets = await getProjectsByCategory("cashtokens:wallet");
const reference = await getProjectsByCategory("cashtokens:reference");
const nfts = await getProjectsByCategory("cashtokens:nft");
const fungibles = await getProjectsByCategory("cashtokens:fungible");
const faucets = await getProjectsByCategory("cashtokens:faucet");
const explorers = await getProjectsByCategory("cashtokens:explorer");
const bcmrs = await getProjectsByCategory("cashtokens:bcmr");
const mentors = await getProjectsByCategory("build:mentor");
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <Boxes title={copy.devTools.title} subtitle={copy.devTools.subtitle} highlight="" items={devTools} />

  <Boxes subtitle={copy.wallets.subtitle} items={wallets} />

  <Boxes subtitle={copy.reference.subtitle} items={reference} />

  <Boxes subtitle={copy.nfts.subtitle} items={nfts} />

  <Boxes subtitle={copy.fungibles.subtitle} items={fungibles} />

  <Boxes subtitle={copy.faucets.subtitle} items={faucets} />

  <Boxes subtitle={copy.explorers.subtitle} items={explorers} />

  <Boxes subtitle={copy.bcmrs.subtitle} items={bcmrs} />

  <Boxes subtitle={copy.mentors.subtitle} items={mentors} />

  <BlogLatestPosts title={copy.tutorials.title} category="Tutorial" />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title={copy.video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <Features highlight="" title={copy.native.title} subtitle={copy.native.subtitle} items={copy.native.items} />

  <Features highlight="" title={copy.honest.title} subtitle={copy.honest.subtitle} items={copy.honest.items} />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: copy.cta.action,
        href: 'https://t.me/bchworks',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">{copy.cta.title}</Fragment>
    <Fragment slot="subtitle">{copy.cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
