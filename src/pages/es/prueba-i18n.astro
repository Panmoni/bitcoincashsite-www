---
// Fixture for the locale routing (PAN-376): proves /es/ pages get lang, dir
// and the draft noindex from src/i18n/locales.ts. The bare Layout keeps the
// English header and footer out. Remove once real Spanish pages ship.
//
// It also proves the fragment fallback (PAN-378, docs/i18n.md): the glossary
// term below has no Spanish overlay, so it renders in English inside
// lang="en" data-l10n-fallback.
import { getEntry } from "astro:content";
import LocalizedText from "~/components/common/LocalizedText.astro";
import Layout from "~/layouts/Layout.astro";
import { localizeRecord } from "~/utils/l10n";

const metadata = {
	title: "Prueba de idioma",
	description: "Página de prueba de las rutas en español.",
};

const utxo = await getEntry("glossary", "utxo");
if (!utxo) throw new Error("glossary entry utxo is missing");
const term = localizeRecord(
	{ id: utxo.id, term: utxo.data.term, definition: utxo.data.definition },
	"glossary",
	["term", "definition"],
	"es",
);
---

<Layout metadata={metadata}>
  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-bold">Prueba de idioma</h1>
    <p class="mt-4">Esta página comprueba las rutas en español. Todavía no hay contenido traducido.</p>
    <dl class="mt-4">
      <dt class="font-bold"><LocalizedText value={term.term} /></dt>
      <dd><LocalizedText value={term.definition} /></dd>
    </dl>
  </main>
</Layout>
