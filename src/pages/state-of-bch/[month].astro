---
import { getCollection, render } from "astro:content";
import ArticleShell from "~/components/reference/ArticleShell.astro";
import { getPageCopy } from "~/utils/pages";

export const getStaticPaths = async () =>
	(await getCollection("reports")).map((entry) => ({
		params: { month: entry.data.month },
		props: { entry },
	}));

const copy = await getPageCopy("state-of-bch-entry");
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<ArticleShell
  title={d.title}
  description={d.description}
  verified={d.verified}
  eyebrow={copy.eyebrow.replace('{month}', d.month)}
  faq={d.faq}
  sources={d.sources}
>
  <Content />
</ArticleShell>
