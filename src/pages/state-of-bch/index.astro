---
import { getCollection } from "astro:content";
import BchVitals from "~/components/reference/BchVitals.astro";
import RealNumbers from "~/components/reference/RealNumbers.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPageCopy } from "~/utils/pages";

const copy = await getPageCopy("state-of-bch-index");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const reports = (await getCollection("reports")).sort((a, b) =>
	b.data.month.localeCompare(a.data.month),
);
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <BchVitals />
    <RealNumbers />
    <h2 class="font-heading text-3xl font-extrabold tracking-tight mt-10 mb-4">{copy.reports.title}</h2>
    {
      reports.length ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {reports.map((r) => (
            <li>
              <a class="wb-card wb-card-hover block p-5" href={`/state-of-bch/${r.data.month}`}>
                <span class="font-mono text-xs text-muted">{r.data.month}</span>
                <span class="block font-heading text-xl font-extrabold">{r.data.title}</span>
                <span class="block text-sm text-muted mt-1">{r.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted">{copy.reports.empty}</p>
      )
    }
  </section>
</Layout>
