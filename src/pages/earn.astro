---
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getProjectsByCategory } from "~/utils/projects";

const metadata = {
	title: "Earn Bitcoin Cash BCH: Work, Build, Tip and Get Paid",
	description:
		"Ways to earn Bitcoin Cash: freelance, create, tip, claim bounties, crowdfund with Flipstarter, run infrastructure or charge per use with micropayments.",
	ignoreTitleTemplate: true,
};

const social = await getProjectsByCategory("earn:social");
const defi = await getProjectsByCategory("earn:defi");
const gaming = await getProjectsByCategory("earn:gaming");
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">Earn Bitcoin Cash</Fragment>
    <Fragment slot="subtitle">Get paid in money that costs a tenth of a cent to move. Even small amounts are worth sending.</Fragment>
  </InnerTitle>

  <Boxes
    title="How to Earn BCH"
    subtitle="Micro-fees change what is worth charging for. A $0.05 tip, a pay-per-article fee or a per-call API price all make sense when moving the money costs about $0.001."
    highlight="Earn some BCH"
    items={[
      {
        title: 'Freelance & Sell',
        description: 'Invoice clients anywhere in BCH. No platform cut, no payout delay, no chargebacks.',
        url: '/accept',
      },
      {
        title: 'Build & Claim Bounties',
        description: 'Ship wallets, tools and contracts. Community bounties and Flipstarter crowdfunds pay builders in BCH.',
        url: '/build',
      },
      {
        title: 'Charge per Use',
        description: 'Sell API calls, downloads or AI-agent jobs for cents. BCH fees are small enough to make per-use pricing work.',
        url: '/build',
      },
      {
        title: 'Run Infrastructure',
        description: 'Mine blocks, or run the nodes and indexers apps depend on. Mining needs real capital; do the maths first.',
        url: '/mining',
      },
    ]}
  />

  <Boxes subtitle="Social & Tipping" items={social} />

  <Boxes subtitle="DeFi Protocols" items={defi} />

  <Boxes subtitle="Gaming" items={gaming} />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <Features
    highlight=""
    title="Why earn in BCH"
    subtitle="The upside, and the trade-offs."
    items={[
      {
        title: 'Keep what you earn',
        icon: 'tabler:cash',
        description:
          'About $0.001 per payment, flat. A $2 tip arrives as $2, not $1.40 after platform and card fees.',
      },
      {
        title: 'Paid from anywhere',
        icon: 'tabler:world',
        description:
          'A client abroad pays you the same way a neighbour does. No bank wire, no payout threshold, no waiting days.',
      },
      {
        title: 'Built for small payments',
        icon: 'tabler:robot',
        description:
          'Machines can pay machines. Pay-per-call APIs and AI agents that pay for what they use are practical at these fees.',
      },
      {
        title: 'No account to freeze',
        icon: 'tabler:key',
        description:
          'Earnings land in a wallet you control. No platform can hold your balance or close your account.',
      },
      {
        title: 'Crowdfund with Flipstarter',
        icon: 'tabler:heart-handshake',
        description:
          'Pledges only settle if the goal is reached, enforced on-chain. BCH developers have funded years of work this way.',
      },
      {
        title: 'Mind the price',
        icon: 'tabler:chart-line',
        description:
          'BCH is volatile. If you need stable income, convert part of each payment, or hold a BCH stablecoin such as ParyonUSD.',
      },
    ]}
  />
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get BCH updates',
        href: 'https://t.me/bchworks',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Get BCH Updates</Fragment>
    <Fragment slot="subtitle">Upgrades, tools and ecosystem news, without the hype.</Fragment>
  </CallToAction>
</Layout>
