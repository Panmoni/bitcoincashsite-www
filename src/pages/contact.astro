---
import ContactUs from "~/components/widgets/Contact.astro";
import Features2 from "~/components/widgets/Features2.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import Layout from "~/layouts/PageLayout.astro";

const metadata = {
	title: "Contact",
	description:
		"Contact BCH Works for corrections, project listings or questions about Bitcoin Cash.",
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Talk to BCH Works" />

  <ContactUs
    title="Send us a message"
    subtitle="Corrections, project listings, partnerships or questions about Bitcoin Cash. For general BCH help, the community on our Support page is often faster."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="A small team reads every message. We usually reply within a few business days."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Other ways to reach us"
    items={[
      {
        title: 'Corrections',
        description:
          'Spotted a wrong fact, a dead project or a broken link? Tell us. Keeping BCH information current is the point of this site.',
      },
      {
        title: 'List your project',
        description:
          'Building on Bitcoin Cash? Send us the link and one line on what it does. We list working, self-custody-friendly projects.',
      },
      {
        title: 'Email',
        description: 'hello@panmoni.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Telegram',
        description: 't.me/bitcoincashsite',
        icon: 'tabler:brand-telegram',
      },
    ]}
  />
</Layout>
