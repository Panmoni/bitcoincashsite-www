---
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getProjectsByCategory } from "~/utils/projects";

const metadata = {
	title: "Spend Bitcoin Cash: Pay Anyone for Under a Cent",
	description:
		"Where and how to spend Bitcoin Cash. Pay merchants, friends and online stores for under a cent per payment, with no account and no one's permission.",
	ignoreTitleTemplate: true,
};

const merchants = await getProjectsByCategory("spend");
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">Spend Bitcoin Cash</Fragment>
    <Fragment slot="subtitle">Money that works: pay anyone, anywhere, for under a cent. No account, no card, no permission.</Fragment>
  </InnerTitle>

  <Boxes
    title="Where to Spend BCH"
    subtitle="Merchant maps, gift-card shops and services that take BCH. Can't find a local shop? Show one how to accept it; it takes a phone and five minutes."
    highlight=""
    items={merchants}
  />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <Features
    highlight=""
    title="Why pay with BCH"
    subtitle="What it does well, and where it falls short."
    items={[
      {
        title: 'Under a cent',
        icon: 'tabler:cash',
        description:
          'A typical payment costs about $0.001 in fees, whether you send $1 or $1,000. Small payments finally make sense.',
      },
      {
        title: 'Works like cash',
        icon: 'tabler:coins',
        description:
          'Each coin in your wallet is an object with a value and a lock. You hand it over; it is theirs. No bank in the middle, no card number to leak.',
      },
      {
        title: 'Seen in seconds',
        icon: 'tabler:bolt',
        description:
          'The shop sees your payment within seconds. It is written into a block about every 10 minutes.',
      },
      {
        title: 'No account needed',
        icon: 'tabler:user-off',
        description:
          'Install a wallet and you can pay. No sign-up, no minimum balance, and no one who can freeze your wallet.',
      },
      {
        title: 'Across borders',
        icon: 'tabler:world',
        description:
          'Pay a seller in another country the same way you pay one next door. Same fee, no currency desk.',
      },
      {
        title: 'Honest limits',
        icon: 'tabler:alert-triangle',
        description:
          'Fewer shops take BCH than cards. Payments are public on the ledger, so do not assume privacy. Prices move, so spend what you are comfortable holding.',
      },
    ]}
  />
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get BCH updates',
        href: 'https://t.me/bitcoincashsite',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Get BCH Updates</Fragment>
    <Fragment slot="subtitle">Upgrades, tools and ecosystem news, without the hype.</Fragment>
  </CallToAction>
</Layout>
