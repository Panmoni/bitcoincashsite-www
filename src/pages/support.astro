---
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import FAQs from "~/components/widgets/FAQs.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPageCopy } from "~/utils/pages";
import { getProjectsByCategory } from "~/utils/projects";

const copy = await getPageCopy("support");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const discussion = await getProjectsByCategory("support:discussion");
const media = await getProjectsByCategory("support:media");
const podcasts = await getProjectsByCategory("support:podcast");
const general = await getProjectsByCategory("support:general");
const papers = await getProjectsByCategory("support:paper");
const utilities = await getProjectsByCategory("support:utility");
const financial = await getProjectsByCategory("support:financial");
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <Boxes
    title={copy.discussion.title}
    subtitle={copy.discussion.subtitle}
    highlight=""
    items={discussion}
  />

  <Boxes subtitle={copy.media.subtitle} items={media} />

  <Boxes subtitle={copy.podcasts.subtitle} items={podcasts} />

  <Boxes subtitle={copy.general.subtitle} items={general} />

  <Boxes subtitle={copy.financial.subtitle} items={financial} />

  <Boxes subtitle={copy.papers.subtitle} items={papers} />

  <Boxes subtitle={copy.utilities.subtitle} items={utilities} />

  <FAQs
    title={copy.faq.title}
    subtitle={copy.faq.subtitle}
    highlight=""
    items={copy.faq.items}
  />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title={copy.video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: copy.cta.action,
        href: 'https://t.me/bchworks',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">{copy.cta.title}</Fragment>
    <Fragment slot="subtitle">{copy.cta.subtitle}</Fragment>
  </CallToAction>
</Layout>
