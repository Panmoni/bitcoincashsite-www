---
import { getCollection, render } from "astro:content";
import ArticleShell from "~/components/reference/ArticleShell.astro";
import RealNumbers from "~/components/reference/RealNumbers.astro";
import { getPageCopy } from "~/utils/pages";
import { type ChainId, metrics } from "~/utils/reference";

export const getStaticPaths = async () =>
	(await getCollection("compare")).map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));

const copy = await getPageCopy("compare-entry");
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const rival = d.ticker.toLowerCase();
const compare = (rival in metrics.chains ? [rival] : []) as ChainId[];
---

<ArticleShell
  title={d.title}
  description={d.description}
  verified={d.verified}
  eyebrow={copy.eyebrow.replaceAll('{ticker}', () => d.ticker)}
  faq={d.faq}
  sources={d.sources}
>
  <Fragment slot="before">
    <RealNumbers compare={compare} title={copy.numbers.replaceAll('{ticker}', () => d.ticker)} />
  </Fragment>
  <Content />
</ArticleShell>
