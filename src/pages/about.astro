---
import Button from "~/components/ui/Button.astro";
import Layout from "~/layouts/PageLayout.astro";
import { type CopyList, getPageCopy } from "~/utils/pages";
import { getPermalink } from "~/utils/permalinks";

const copy = await getPageCopy("about");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const { rules } = copy.principles;
const { rows: limits } = copy.limits;
const { outputs, funderList: funders } = copy.books;
const { blocks } = copy.history;
const { brands } = copy.brand;

const donateAddress = "bitcoincash:qz3pxmwda8gd42wa8k9yfxcwhcaapeuhygjc8mc4m8";

const isExternal = (href: string) => href.startsWith("http");

// The last funders entry is "6 anonymous donors": count them as six people.
const funderCount = funders.length - 1 + 6;
---

<Layout metadata={metadata}>
  <!-- Header: the Flipstarter as a receipt -->
  <section class="px-4 sm:px-6">
    <div class="max-w-7xl mx-auto pt-10 pb-12 md:pt-16 md:pb-16 grid lg:grid-cols-[1.2fr_1fr] gap-10 items-end">
      <div>
        <span class="wb-chip">{copy.header.chip}</span>
        <h1 class="mt-5 mb-5 font-heading text-[clamp(2.75rem,6vw,5rem)] font-extrabold leading-[1.1] tracking-[-0.045em]" set:html={copy.header.title} />
        <p class="text-xl text-muted max-w-[52ch]">{copy.header.intro}</p>
      </div>
      <figure class="relative wb-card overflow-hidden rotate-[1.5deg] shadow-hard-lg">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b-2 border-line bg-soft" aria-hidden="true">
          <i class="w-2.5 h-2.5 rounded-full bg-wb-pink"></i>
          <i class="w-2.5 h-2.5 rounded-full bg-wb-yellow"></i>
          <i class="w-2.5 h-2.5 rounded-full bg-wb-green"></i>
          <span class="ml-auto font-mono text-xs text-muted">{copy.header.receipt.tag}</span>
        </div>
        <div class="p-6">
          <p class="font-mono text-5xl md:text-6xl font-bold leading-none tracking-[-0.05em]">{copy.header.receipt.amount}</p>
          <p class="mt-2 text-muted">{copy.header.receipt.caption}</p>
          <dl class="mt-5 font-mono text-sm grid gap-1.5">
            <div class="flex gap-2"><dt>{copy.header.receipt.raisedIn}</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">{copy.header.receipt.raisedInValue}</dd></div>
            <div class="flex gap-2"><dt>{copy.header.receipt.inputs}</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">{funderCount}</dd></div>
            <div class="flex gap-2"><dt>{copy.header.receipt.fastest}</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">{copy.header.receipt.fastestValue}</dd></div>
            <div class="flex gap-2"><dt>{copy.header.receipt.ads}</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">{copy.header.receipt.adsValue}</dd></div>
          </dl>
          <a href="https://archive.ph/50X6L" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block font-mono text-sm font-bold underline underline-offset-4">{copy.header.receipt.link}</a>
        </div>
      </figure>
    </div>
  </section>

  <!-- Inputs → outputs -->
  <section id="books" class="px-4 sm:px-6 py-10 md:py-14 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">{copy.books.chip}</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{copy.books.title}</h2>
        </div>
        <p class="text-muted max-w-[44ch]">{copy.books.intro}</p>
      </div>
      <div class="wb-card overflow-hidden grid lg:grid-cols-[1fr_auto_1fr]">
        <div class="p-6 flex flex-col gap-4">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider">{copy.books.inputs} · {funderCount} {copy.books.funders}</h3>
          <ul class="flex flex-wrap gap-1.5">
            {(funders as string[]).map((name) => <li class="font-mono text-xs border-2 border-line rounded-md px-2 py-0.5 bg-soft/60">{name}</li>)}
          </ul>
          <p class="text-muted text-sm">
            {copy.books.others}
          </p>
        </div>
        <div class="grid place-items-center border-y-2 lg:border-y-0 lg:border-x-2 border-line bg-wb-green text-on-accent font-heading text-3xl font-extrabold py-2 lg:px-4" aria-hidden="true">
          <span class="lg:hidden">↓</span><span class="hidden lg:inline">→</span>
        </div>
        <div class="p-6 flex flex-col gap-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider">{copy.books.outputsTitle}</h3>
          <ul class="grid gap-2.5">
            {
              (outputs as CopyList).map(({ title, body, tone }) => (
                <li class:list={['border-2 border-line rounded-lg px-4 py-3 grid gap-0.5', tone]}>
                  <span class="font-mono text-xs font-bold uppercase tracking-wider">{title}</span>
                  <span class="text-[15px]">{body}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Rules, with examples -->
  <section id="principles" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">{copy.principles.chip}</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{copy.principles.title}</h2>
        </div>
        <p class="text-muted max-w-[44ch]">{copy.principles.intro}</p>
      </div>
      <ul class="grid gap-5 md:grid-cols-2">
        {
          (rules as CopyList).map(({ code, title, body, yes, no, tone }) => (
            <li class="wb-card overflow-hidden flex flex-col">
              <div class="p-6 flex flex-col gap-2">
                <span class="flex items-center gap-2 font-mono text-xs font-bold">
                  <i class:list={['w-3 h-3 rounded-full border-2 border-line', tone]} aria-hidden="true"></i>{code}
                </span>
                <h3 class="font-heading text-2xl font-extrabold tracking-tight leading-tight">{title}</h3>
                <p class="text-muted text-[15px]">{body}</p>
              </div>
              <dl class="mt-auto grid sm:grid-cols-2 border-t-2 border-line text-[15px]">
                <div class="p-5 sm:border-r-2 border-b-2 sm:border-b-0 border-line">
                  <dt class="font-mono text-[11px] font-bold uppercase tracking-wider mb-1.5">{copy.principles.yes}</dt>
                  <dd class="font-semibold">“{yes}”</dd>
                </div>
                <div class="p-5 bg-soft/50">
                  <dt class="font-mono text-[11px] font-bold uppercase tracking-wider mb-1.5">{copy.principles.no}</dt>
                  <dd class="font-semibold text-muted line-through decoration-wb-pink decoration-2">“{no}”</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Rule 2, in full -->
  <section id="limits" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">{copy.limits.chip}</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{copy.limits.title}</h2>
        </div>
        <p class="text-muted max-w-[44ch]">
          {copy.limits.introBefore} <a href={getPermalink('/bitcoin-cash')} class="font-bold underline underline-offset-4">{copy.limits.introLink}</a> {copy.limits.introAfter}
        </p>
      </div>
      <div class="wb-card overflow-x-auto">
        <table class="w-full text-left text-[15px] border-collapse">
          <thead>
            <tr class="border-b-2 border-line font-mono text-[11px] uppercase tracking-wider">
              <th class="px-5 py-3">{copy.limits.columns.limit}</th>
              <th class="px-5 py-3">{copy.limits.columns.fact}</th>
              <th class="px-5 py-3">{copy.limits.columns.meaning}</th>
            </tr>
          </thead>
          <tbody>
            {
              (limits as CopyList).map(({ limit, fact, meaning }) => (
                <tr class="border-b-2 border-soft last:border-b-0 align-top">
                  <th scope="row" class="px-5 py-4 font-bold whitespace-nowrap">{limit}</th>
                  <td class="px-5 py-4 font-mono text-sm whitespace-nowrap">{fact}</td>
                  <td class="px-5 py-4 text-muted min-w-[28ch]">{meaning}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- History as blocks -->
  <section id="history" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <span class="wb-chip">{copy.history.chip}</span>
      <h2 class="mt-3 mb-8 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{copy.history.title}</h2>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
        {
          (blocks as CopyList).map(({ label, date, body, link, pending }, i) => (
            <li class:list={['relative p-4 flex flex-col gap-2 border-2 border-line rounded-wb', pending ? 'border-dashed bg-transparent' : 'bg-surface shadow-hard']}>
              {i < blocks.length - 1 && (
                <span aria-hidden="true" class="hidden xl:block absolute top-9 -right-[1.625rem] w-6 h-0.5 bg-line"></span>
              )}
              <span class="font-mono text-[11px] text-muted">{label}</span>
              <span class="font-mono text-lg font-bold leading-tight">{date}</span>
              <p class="text-muted text-sm">{body}</p>
              {link && (
                <a
                  href={isExternal(link.href) ? link.href : getPermalink(link.href)}
                  {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="mt-auto pt-1 font-mono text-xs font-bold underline underline-offset-4"
                >
                  {link.text} →
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Who's behind it -->
  <section id="family" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="mb-8">
        <span class="wb-chip">{copy.family.chip}</span>
        <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]" set:html={copy.family.title} />
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <a href="https://www.panmoni.com/" target="_blank" rel="noopener noreferrer" class="wb-card wb-card-hover p-6 flex flex-col gap-3">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">{copy.family.panmoni.label}</span>
          <img src="/brand/panmoni/PAN-Icon-512x512.png" alt="" width="48" height="48" loading="lazy" class="w-12 h-12" />
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">{copy.family.panmoni.title}</h3>
          <p class="text-muted text-[15px]" set:html={copy.family.panmoni.body} />
          <span class="mt-auto pt-2 font-mono text-[13px] text-muted">{copy.family.panmoni.cta}</span>
        </a>
        <a href="https://tokenstork.com/" target="_blank" rel="noopener noreferrer" class="wb-card wb-card-hover p-6 flex flex-col gap-3 bg-wb-yellow text-on-accent [&_p]:text-on-accent">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">{copy.family.tokenstork.label}</span>
          <h3><img src="/brand/tokenstork-logo.png" alt={copy.family.tokenstork.logoAlt} width="553" height="100" loading="lazy" class="h-10 w-auto" /></h3>
          <p class="text-[15px]">{copy.family.tokenstork.body}</p>
          <span class="mt-auto pt-2 font-mono text-[13px]">{copy.family.tokenstork.cta}</span>
        </a>
        <div class="wb-card p-6 flex flex-col gap-3 bg-wb-green text-on-accent [&_p]:text-on-accent">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">{copy.family.latam.label}</span>
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">{copy.family.latam.title}</h3>
          <p class="text-[15px]">{copy.family.latam.body}</p>
          <div class="mt-auto pt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[13px] font-bold">
            <a href="https://x.com/bchlatam" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{copy.family.latam.x}</a>
            <a href="http://t.me/bchlatam" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{copy.family.latam.telegram}</a>
          </div>
        </div>
        <div class="wb-card p-6 flex flex-col gap-3">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">{copy.family.corrections.label}</span>
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">{copy.family.corrections.title}</h3>
          <p class="text-muted text-[15px]">{copy.family.corrections.body}</p>
          <a href="mailto:hello@panmoni.com" class="mt-auto pt-2 font-mono text-[13px] font-bold underline underline-offset-4">hello@panmoni.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Brand assets -->
  <section id="brand" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="mb-8">
        <span class="wb-chip">{copy.brand.chip}</span>
        <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{copy.brand.title}</h2>
        <p class="mt-3 text-muted text-[15px] max-w-[52ch]">{copy.brand.intro}</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          (brands as CopyList).map(({ name, zip, logos, source }) => (
            <div class="wb-card p-6 flex flex-col gap-4">
              <h3 class="font-heading text-2xl font-extrabold tracking-tight">{name}</h3>
              <div class="grid gap-3 grid-cols-2">
                {(logos as CopyList).map(({ src, dark }) => (
                  <div class:list={["border-2 border-line rounded-lg p-4 h-28 flex items-center justify-center", dark ? "bg-[#111418]" : "bg-white", logos.length % 2 && "first:col-span-2"]}>
                    <img src={src} alt={`${name} ${copy.brand.logoAlt}`} loading="lazy" class="max-h-full max-w-full object-contain" />
                  </div>
                ))}
              </div>
              <div class="mt-auto flex flex-col gap-1">
                <a href={zip} download class="font-mono text-sm font-bold underline underline-offset-4">{copy.brand.download} {name} {copy.brand.downloadSuffix}</a>
                {source && (
                  <span class="text-muted text-[13px]">
                    {copy.brand.source} <a href={source.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{source.text} ↗</a>
                  </span>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Add an input -->
  <section id="contact" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="wb-card p-6 md:p-8 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
        <div class="flex flex-col gap-3">
          <span class="wb-chip self-start">{copy.contact.chip}</span>
          <h2 class="font-heading text-4xl md:text-5xl font-extrabold leading-none tracking-[-0.04em]">{copy.contact.title}</h2>
          <p class="text-muted text-[15px] max-w-[52ch]">{copy.contact.intro}</p>
        </div>
        <div class="flex flex-col gap-2 justify-end">
          <span class="font-mono text-xs text-muted">{copy.contact.donate}</span>
          <a href={donateAddress} class="font-mono text-sm font-bold break-all border-2 border-line rounded-lg p-3 bg-wb-green text-on-accent">{donateAddress}</a>
        </div>
      </div>
      <div class="mt-5 grid gap-5">
        <div class="wb-card p-6 flex flex-col gap-3">
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">{copy.contact.talkTitle}</h3>
          <p class="text-muted text-[15px]">{copy.contact.talkBody}</p>
          <div class="mt-auto flex flex-col gap-2 font-mono text-sm font-bold">
            <a href="mailto:hello@panmoni.com" class="underline underline-offset-4">hello@panmoni.com</a>
            <a href="https://t.me/bchworks" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{copy.contact.telegram}</a>
          </div>
        </div>
      </div>
      <p class="mt-6 text-muted text-sm">{copy.contact.affiliate}</p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <Button variant="primary" href={getPermalink('/bitcoin-cash')} text={copy.contact.why} class="w-full sm:w-auto" />
        <Button href={getPermalink('/onboard')} text={copy.contact.wallet} class="w-full sm:w-auto" />
      </div>
    </div>
  </section>
</Layout>
