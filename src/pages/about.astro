---
import Button from "~/components/ui/Button.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPermalink } from "~/utils/permalinks";

const metadata = {
	title: "About BCH Works",
	description:
		"BCH Works makes Bitcoin Cash legible and alive: honest, data-first guides and tools for using and building on BCH. Crowdfunded with 277.08 BCH in 2020. A Panmoni project.",
};

const rules = [
	{
		code: "rule_01 data_first",
		title: "Show the number.",
		body: "Fees, block sizes and upgrade dates. We show you the number, not an adjective.",
		yes: "A test transaction costs about $0.001.",
		no: "Near-zero fees, lightning fast!",
		tone: "bg-wb-green",
	},
	{
		code: "rule_02 limits",
		title: "Say what's weak.",
		body: "BCH has a small ecosystem, thin liquidity, 10-minute blocks and no default privacy. We say so, next to the good parts.",
		yes: "Payments show up in seconds. Final settlement takes about 10 minutes.",
		no: "Instant, final payments.",
		tone: "bg-wb-yellow",
	},
	{
		code: "rule_03 hands_on",
		title: "Let you try it.",
		body: "We point you at things you can try yourself, not things to take on faith.",
		yes: "Send yourself a few cents and watch it arrive.",
		no: "Trust us, it works.",
		tone: "bg-wb-blue",
	},
	{
		code: "rule_04 no_price",
		title: "No price talk.",
		body: "We don't predict prices or promise returns. This site is about what BCH does.",
		yes: "BCH is volatile. Hold only what you can afford to lose.",
		no: "BCH to $10k by the next halving.",
		tone: "bg-wb-pink",
	},
];

const limits = [
	{
		limit: "Settlement",
		fact: "~10 min per block",
		meaning:
			"Payments appear in seconds. For a large sale, wait for a block before you hand over the goods.",
	},
	{
		limit: "Liquidity",
		fact: "thin",
		meaning:
			"Fewer exchanges and order books than BTC or stablecoins. Big trades move the price, so check the spread first.",
	},
	{
		limit: "Privacy",
		fact: "public by default",
		meaning:
			"Anyone can read an address's history. Use a fresh address for each payment you receive.",
	},
	{
		limit: "Ecosystem",
		fact: "small",
		meaning:
			"Fewer wallets, merchants and developers than larger chains. Ask a shop before you pay with it.",
	},
];

const outputs = [
	{
		title: "1,000+ merchants",
		body: "onboarded across Venezuela, 2020–2022",
		tone: "bg-wb-green text-on-accent",
	},
	{
		title: "2,500+ users",
		body: "first wallet, first payment",
		tone: "bg-surface",
	},
	{
		title: "Token Pioneers",
		body: "the CashTokens tutorial series, 2023",
		tone: "bg-wb-yellow text-on-accent",
	},
	{
		title: "TokenStork",
		body: "a directory of every CashToken, 2024",
		tone: "bg-surface",
	},
	{
		title: "BCH Works",
		body: "this site, rewritten in 2026",
		tone: "bg-wb-pink text-on-accent",
	},
];

const blocks = [
	{
		label: "block 0 · genesis",
		date: "Aug 2020",
		body: "George Donnelly starts BitcoinCash.site. Goal: one million new Bitcoin Cash users.",
	},
	{
		label: "block 1",
		date: "Sep 2020",
		body: "A Flipstarter raises 277.08 BCH in five hours, the fastest at the time.",
		link: { text: "Archived campaign", href: "https://archive.ph/50X6L" },
	},
	{
		label: "block 2",
		date: "2020–22",
		body: "The Panmoni team onboards 1,000+ merchants and 2,500+ users across Venezuela, on a shoestring budget.",
		link: {
			text: "Photo book",
			href: "/blog/bitcoin-agents-venezuela-photo-book",
		},
	},
	{
		label: "block 3",
		date: "2023",
		body: "CashTokens go live. Token Pioneers teaches people to mint their own.",
		link: {
			text: "Tutorial #1",
			href: "/blog/token-pioneers-cashtokens-tutorial-1",
		},
	},
	{
		label: "block 4",
		date: "2024",
		body: "TokenStork launches: a directory and explorer for every CashToken.",
		link: { text: "About TokenStork", href: "/blog/tokenstork" },
	},
	{
		label: "block 5",
		date: "2026",
		body: "Renamed BCH Works, with a new design and an honest rewrite.",
	},
	{
		label: "mempool · unconfirmed",
		date: "Next",
		body: "Live views of the chain from our own full node, and covenant templates you can try on mainnet.",
		pending: true,
	},
];

const logos = [
	{ text: "Bitcoin Cash", href: "https://bitcoinbch.com/resources/logos.html" },
	{
		text: "BitcoinCash.site",
		href: "https://www.dropbox.com/sh/i89h0isev26nevt/AADc6bVi3edDwD54rSf5zDqYa?dl=0",
	},
	{
		text: "BCH Latam",
		href: "https://www.dropbox.com/sh/537eo1uzp6vj1kv/AABEpmH7vemoNRPFs2L5ztMMa?dl=0",
	},
	{
		text: "Panmoni",
		href: "https://www.dropbox.com/sh/kjt001spi5ur54l/AACyHqMraIUJPBBsGYct98Cga?dl=0",
	},
];

const funders = [
	"Mike Komaransky",
	"Georg Engelmann",
	"Roger Ver",
	"toorik",
	"Majamalu",
	"Satoshi’s Angels",
	"William Patrick",
	"btcfork",
	"S0me_N0b0dy",
	"“Adam Draper”",
	"molecular",
	"AsahoryuMaryBerry",
	"read.cash",
	"Henry Cashlitt",
	"Jonathan Toomim",
	"FreeTrade",
	"emergent reasons",
	"RadTadd",
	"na",
	"Kaizen",
	"ProofOfConcept",
	"Shomari Prince",
	"Yasu",
	"John Floss",
	"Shadows",
	"SeptMike",
	"ChainXOR",
	"Stockleezy",
	"BitcoinTippingPoint",
	"AD1AD",
	"m4ktub",
	"sambarboza",
	"AndrewJD123",
	"BitcoinCashJesus3",
	"Holy Jesus Piece",
	"Crazy (loco) Money (pecunia)",
	"GoatPharmer",
	"cryptopanda15",
	"lugaxker",
	"Telesfor",
	"TAOJONES",
	"f.b.",
	"earaya",
	"curioustitmouse",
	"tiyoaeyo",
	"zquestz",
	"NgocTranTL",
	"saddit42",
	"n00b",
	"6 anonymous donors",
];

const donateAddress = "bitcoincash:qz3pxmwda8gd42wa8k9yfxcwhcaapeuhygjc8mc4m8";

const isExternal = (href: string) => href.startsWith("http");

// The last funders entry is "6 anonymous donors": count them as six people.
const funderCount = funders.length - 1 + 6;
---

<Layout metadata={metadata}>
  <!-- Header: the Flipstarter as a receipt -->
  <section class="px-4 sm:px-6">
    <div class="max-w-7xl mx-auto pt-10 pb-12 md:pt-16 md:pb-16 grid lg:grid-cols-[1.2fr_1fr] gap-10 items-end">
      <div>
        <span class="wb-chip">About</span>
        <h1 class="mt-5 mb-5 font-heading text-[clamp(2.75rem,6vw,5rem)] font-extrabold leading-[1.1] tracking-[-0.045em]">
          Not a sales pitch. A <mark class="bg-wb-green text-on-accent px-[0.12em] rounded-[0.12em] [box-decoration-break:clone]">workbench</mark>.
        </h1>
        <p class="text-xl text-muted max-w-[52ch]">
          In 2020 the Bitcoin Cash community funded this site in five hours. We still show our work. BCH Works explains how Bitcoin Cash works, what it's good at and where it falls short. Then it helps you try it yourself.
        </p>
      </div>
      <figure class="relative wb-card overflow-hidden rotate-[1.5deg] shadow-hard-lg">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b-2 border-line bg-soft" aria-hidden="true">
          <i class="w-2.5 h-2.5 rounded-full bg-wb-pink"></i>
          <i class="w-2.5 h-2.5 rounded-full bg-wb-yellow"></i>
          <i class="w-2.5 h-2.5 rounded-full bg-wb-green"></i>
          <span class="ml-auto font-mono text-xs text-muted">tx · flipstarter · sep 2020</span>
        </div>
        <div class="p-6">
          <p class="font-mono text-5xl md:text-6xl font-bold leading-none tracking-[-0.05em]">277.08 BCH</p>
          <p class="mt-2 text-muted">Raised from the community to start this site.</p>
          <dl class="mt-5 font-mono text-sm grid gap-1.5">
            <div class="flex gap-2"><dt>raised in</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">5 hours</dd></div>
            <div class="flex gap-2"><dt>inputs (funders)</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">{funderCount}</dd></div>
            <div class="flex gap-2"><dt>fastest Flipstarter</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">at the time</dd></div>
            <div class="flex gap-2"><dt>ads on this site</dt><span aria-hidden="true" class="flex-1 border-b-2 border-dotted border-line/40 mb-1"></span><dd class="font-bold">0</dd></div>
          </dl>
          <a href="https://archive.ph/50X6L" target="_blank" rel="noopener noreferrer" class="mt-6 inline-block font-mono text-sm font-bold underline underline-offset-4">View the archived campaign ↗</a>
        </div>
      </figure>
    </div>
  </section>

  <!-- Inputs → outputs -->
  <section id="books" class="px-4 sm:px-6 py-10 md:py-14 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">Open books</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">Who paid. What it bought.</h2>
        </div>
        <p class="text-muted max-w-[44ch]">Read it like a Bitcoin Cash transaction. Our funders are the inputs. What their money became is the outputs.</p>
      </div>
      <div class="wb-card overflow-hidden grid lg:grid-cols-[1fr_auto_1fr]">
        <div class="p-6 flex flex-col gap-4">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider">Inputs · {funderCount} funders</h3>
          <ul class="flex flex-wrap gap-1.5">
            {funders.map((name) => <li class="font-mono text-xs border-2 border-line rounded-md px-2 py-0.5 bg-soft/60">{name}</li>)}
          </ul>
          <p class="text-muted text-sm">
            Plus PAN SLP token buyers and holders, Read.cash and noise.cash tippers, and chaintippers on Reddit and Twitter.
          </p>
        </div>
        <div class="grid place-items-center border-y-2 lg:border-y-0 lg:border-x-2 border-line bg-wb-green text-on-accent font-heading text-3xl font-extrabold py-2 lg:px-4" aria-hidden="true">
          <span class="lg:hidden">↓</span><span class="hidden lg:inline">→</span>
        </div>
        <div class="p-6 flex flex-col gap-3">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider">Outputs · what it became</h3>
          <ul class="grid gap-2.5">
            {
              outputs.map(({ title, body, tone }) => (
                <li class:list={['border-2 border-line rounded-lg px-4 py-3 grid gap-0.5', tone]}>
                  <span class="font-mono text-xs font-bold uppercase tracking-wider">{title}</span>
                  <span class="text-[15px]">{body}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Rules, with examples -->
  <section id="principles" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">Consensus rules</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">Four rules we don't fork.</h2>
        </div>
        <p class="text-muted max-w-[44ch]">Every page on this site follows them. Here is what each one looks like in a sentence. Tell us when a page breaks one.</p>
      </div>
      <ul class="grid gap-5 md:grid-cols-2">
        {
          rules.map(({ code, title, body, yes, no, tone }) => (
            <li class="wb-card overflow-hidden flex flex-col">
              <div class="p-6 flex flex-col gap-2">
                <span class="flex items-center gap-2 font-mono text-xs font-bold">
                  <i class:list={['w-3 h-3 rounded-full border-2 border-line', tone]} aria-hidden="true"></i>{code}
                </span>
                <h3 class="font-heading text-2xl font-extrabold tracking-tight leading-tight">{title}</h3>
                <p class="text-muted text-[15px]">{body}</p>
              </div>
              <dl class="mt-auto grid sm:grid-cols-2 border-t-2 border-line text-[15px]">
                <div class="p-5 sm:border-r-2 border-b-2 sm:border-b-0 border-line">
                  <dt class="font-mono text-[11px] font-bold uppercase tracking-wider mb-1.5">We write</dt>
                  <dd class="font-semibold">“{yes}”</dd>
                </div>
                <div class="p-5 bg-soft/50">
                  <dt class="font-mono text-[11px] font-bold uppercase tracking-wider mb-1.5">We don't</dt>
                  <dd class="font-semibold text-muted line-through decoration-wb-pink decoration-2">“{no}”</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Rule 2, in full -->
  <section id="limits" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-5 mb-8">
        <div>
          <span class="wb-chip">Rule 2, in full</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">Where BCH falls short.</h2>
        </div>
        <p class="text-muted max-w-[44ch]">
          The weak spots, in one place. <a href={getPermalink('/bitcoin-cash')} class="font-bold underline underline-offset-4">Why Bitcoin Cash</a> covers the strong ones.
        </p>
      </div>
      <div class="wb-card overflow-x-auto">
        <table class="w-full text-left text-[15px] border-collapse">
          <thead>
            <tr class="border-b-2 border-line font-mono text-[11px] uppercase tracking-wider">
              <th class="px-5 py-3">Limit</th>
              <th class="px-5 py-3">In short</th>
              <th class="px-5 py-3">What it means for you</th>
            </tr>
          </thead>
          <tbody>
            {
              limits.map(({ limit, fact, meaning }) => (
                <tr class="border-b-2 border-soft last:border-b-0 align-top">
                  <th scope="row" class="px-5 py-4 font-bold whitespace-nowrap">{limit}</th>
                  <td class="px-5 py-4 font-mono text-sm whitespace-nowrap">{fact}</td>
                  <td class="px-5 py-4 text-muted min-w-[28ch]">{meaning}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- History as blocks -->
  <section id="history" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <span class="wb-chip">History</span>
      <h2 class="mt-3 mb-8 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">One block at a time.</h2>
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">
        {
          blocks.map(({ label, date, body, link, pending }, i) => (
            <li class:list={['relative p-4 flex flex-col gap-2 border-2 border-line rounded-wb', pending ? 'border-dashed bg-transparent' : 'bg-surface shadow-hard']}>
              {i < blocks.length - 1 && (
                <span aria-hidden="true" class="hidden xl:block absolute top-9 -right-[1.625rem] w-6 h-0.5 bg-line"></span>
              )}
              <span class="font-mono text-[11px] text-muted">{label}</span>
              <span class="font-mono text-lg font-bold leading-tight">{date}</span>
              <p class="text-muted text-sm">{body}</p>
              {link && (
                <a
                  href={isExternal(link.href) ? link.href : getPermalink(link.href)}
                  {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="mt-auto pt-1 font-mono text-xs font-bold underline underline-offset-4"
                >
                  {link.text} →
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Who's behind it -->
  <section id="family" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="mb-8">
        <span class="wb-chip">Who's behind it</span>
        <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">Panmoni &amp; TokenStork.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        <a href="https://www.panmoni.com/" target="_blank" rel="noopener noreferrer" class="wb-card wb-card-hover p-6 flex flex-col gap-3">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">The studio</span>
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">Panmoni</h3>
          <p class="text-muted text-[15px]">
            A Web3 product studio founded by <span class="font-bold">George Donnelly</span>. Panmoni builds and runs BCH Works, with a focus on real-world use in Latin America.
          </p>
          <span class="mt-auto pt-2 font-mono text-[13px] text-muted">$ open panmoni.com ↗</span>
        </a>
        <a href="https://tokenstork.com/" target="_blank" rel="noopener noreferrer" class="wb-card wb-card-hover p-6 flex flex-col gap-3 bg-wb-yellow text-on-accent [&_p]:text-on-accent">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">The sister site</span>
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">TokenStork</h3>
          <p class="text-[15px]">
            A directory and explorer for every CashToken on Bitcoin Cash, indexed straight from its own full node. BCH Works covers the chain. TokenStork covers the tokens.
          </p>
          <span class="mt-auto pt-2 font-mono text-[13px]">$ open tokenstork.com ↗</span>
        </a>
        <div class="wb-card p-6 flex flex-col gap-3">
          <span class="font-mono text-xs font-bold uppercase tracking-wider">Found an error?</span>
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">Corrections</h3>
          <p class="text-muted text-[15px]">
            Email us and we fix it. We re-check our guides after every May network upgrade.
          </p>
          <a href="mailto:hello@panmoni.com" class="mt-auto pt-2 font-mono text-[13px] font-bold underline underline-offset-4">hello@panmoni.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Add an input -->
  <section id="contact" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto">
      <div class="wb-card p-6 md:p-8 grid gap-8 lg:grid-cols-[1.3fr_1fr]">
        <div class="flex flex-col gap-3">
          <span class="wb-chip self-start">Add an input</span>
          <h2 class="font-heading text-4xl md:text-5xl font-extrabold leading-none tracking-[-0.04em]">Fund the next block.</h2>
          <p class="text-muted text-[15px] max-w-[52ch]">
            BCH Works runs no ads. Donations pay for the site, our full node and the tools.
          </p>
        </div>
        <div class="flex flex-col gap-2 justify-end">
          <span class="font-mono text-xs text-muted">Donate in BCH</span>
          <a href={donateAddress} class="font-mono text-sm font-bold break-all border-2 border-line rounded-lg p-3 bg-wb-green text-on-accent">{donateAddress}</a>
        </div>
      </div>
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <div class="wb-card p-6 flex flex-col gap-3">
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">Talk to us</h3>
          <p class="text-muted text-[15px]">Want a project listed, or have an idea? Email or join the chat.</p>
          <div class="mt-auto flex flex-col gap-2 font-mono text-sm font-bold">
            <a href="mailto:hello@panmoni.com" class="underline underline-offset-4">hello@panmoni.com</a>
            <a href="https://t.me/bchworks" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">BCH updates on Telegram ↗</a>
          </div>
        </div>
        <div class="wb-card p-6 flex flex-col gap-3">
          <h3 class="font-heading text-2xl font-extrabold tracking-tight">Brand assets</h3>
          <p class="text-muted text-[15px]">Logos for Bitcoin Cash and related projects.</p>
          <ul class="mt-auto grid gap-2 font-mono text-sm font-bold">
            {
              logos.map(({ text, href }) => (
                <li>
                  <a href={href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">{text} ↗</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="mt-6 text-muted text-sm">
        Some links on this site are affiliate links, marked with an asterisk. Photos by
        <a href="https://unsplash.com/@ianstauffer?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener noreferrer" class="underline">Ian Stauffer</a>
        and
        <a href="https://unsplash.com/@timmossholder?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText" target="_blank" rel="noopener noreferrer" class="underline">Tim Mossholder</a>
        on Unsplash.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4">
        <Button variant="primary" href={getPermalink('/bitcoin-cash')} text="Why Bitcoin Cash →" class="w-full sm:w-auto" />
        <Button href={getPermalink('/onboard')} text="Grab a Wallet" class="w-full sm:w-auto" />
      </div>
    </div>
  </section>
</Layout>
