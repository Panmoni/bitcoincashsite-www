---
import { getCollection } from "astro:content";
import Freshness from "~/components/reference/Freshness.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";

const metadata = {
	title: "Bitcoin Cash Glossary: Covenants, CashTokens, BCMR, ABLA and More",
	description:
		"Plain-English definitions of the Bitcoin Cash terms you'll meet: covenant, CashTokens, BCMR, CashAddr, CashFusion, DSProof, ABLA, sighash, P2S and more.",
	ignoreTitleTemplate: true,
};

const terms = (await getCollection("glossary")).sort((a, b) =>
	a.data.term.localeCompare(b.data.term, "en", { sensitivity: "base" }),
);
const byId = new Map(terms.map((t) => [t.id, t]));
const letters = [...new Set(terms.map((t) => t.data.term[0].toUpperCase()))];

const termSet = {
	"@context": "https://schema.org",
	"@type": "DefinedTermSet",
	name: "Bitcoin Cash glossary",
	url: "https://bchworks.com/glossary",
	hasDefinedTerm: terms.map((t) => ({
		"@type": "DefinedTerm",
		name: t.data.term,
		alternateName: t.data.aka.length ? t.data.aka : undefined,
		description: t.data.definition,
		url: `https://bchworks.com/glossary#${t.id}`,
	})),
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(termSet)} />
  </Fragment>

  <InnerTitle>
    <Fragment slot="title">BCH glossary</Fragment>
    <Fragment slot="subtitle">{terms.length} terms, in plain English.</Fragment>
  </InnerTitle>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <nav class="flex flex-wrap gap-2 mb-8" aria-label="Jump to letter">
      {letters.map((l) => <a class="wb-chip" href={`#letter-${l}`}>{l}</a>)}
    </nav>
    {
      letters.map((l) => (
        <section id={`letter-${l}`} class="scroll-mt-24 mb-8">
          <h2 class="font-heading text-3xl font-extrabold mb-3">{l}</h2>
          <dl class="space-y-4">
            {terms
              .filter((t) => t.data.term[0].toUpperCase() === l)
              .map((t) => (
                <div id={t.id} class="wb-card p-4 scroll-mt-24 target:shadow-hard target:bg-soft">
                  <dt class="font-heading text-xl font-extrabold">
                    {t.data.term}
                    {t.data.aka.length > 0 && <span class="ml-2 font-sans text-sm font-normal text-muted">aka {t.data.aka.join(', ')}</span>}
                  </dt>
                  <dd class="mt-2">
                    <p>{t.data.definition}</p>
                    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm items-center">
                      {t.data.link && (
                        <a class="underline" href={t.data.link} {...(t.data.link.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                          Learn more
                        </a>
                      )}
                      {t.data.related
                        .filter((r) => byId.has(r))
                        .map((r) => <a class="font-mono text-xs underline" href={`#${r}`}>{byId.get(r)!.data.term}</a>)}
                      <Freshness date={t.data.verified} />
                    </div>
                  </dd>
                </div>
              ))}
          </dl>
        </section>
      ))
    }
  </section>
</Layout>
