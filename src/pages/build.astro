---
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getProjectsByCategory } from "~/utils/projects";

const metadata = {
	title: "Build on Bitcoin Cash: Covenants, CashTokens and UTXO Contracts",
	description:
		"Bitcoin Cash is the cheapest place to learn and ship Bitcoin-style contracts. Loops, functions, BigInt and native tokens are live on mainnet, and a test transaction costs about $0.001.",
	ignoreTitleTemplate: true,
};

const libraries = await getProjectsByCategory("build:library");
const docs = await getProjectsByCategory("build:docs");
const communities = await getProjectsByCategory("build:community");
const apis = await getProjectsByCategory("build:api");
const contracts = await getProjectsByCategory("build:contracts");
const protocols = await getProjectsByCategory("build:protocol");
const explorers = await getProjectsByCategory("build:explorer");
const network = await getProjectsByCategory("build:network");
const utilities = await getProjectsByCategory("build:utility");
const fullnodes = await getProjectsByCategory("build:fullnode");
const dapps = await getProjectsByCategory("build:dapp");
const cashtokensTooling = await getProjectsByCategory("cashtokens:devtool");
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">Bitcoin's covenant lab, live on mainnet.</Fragment>
    <Fragment slot="subtitle">The contract ideas Bitcoin still debates already run on Bitcoin Cash. Learn them here, where a test transaction costs about $0.001.</Fragment>
  </InnerTitle>

  <Boxes
    title="Start building"
    subtitle="CashScript for contracts, Libauth and Bitauth IDE to step through the VM, mainnet-js for wallets and tokens. All open source."
    highlight=""
    items={[
      {
        title: 'CashTokens Ecosystem',
        description: 'Explore the CashTokens ecosystem.',
        icon: 'https://static.panmoni.com/bitcoincashsite/cashtokenslogo.png',
        url: '/cashtokens',
      },
      ...libraries,
    ]}
  />

  <Boxes subtitle="BCH Documentation" items={docs} />

  <Boxes subtitle="Builder Communities" items={communities} />

  <Boxes subtitle="APIs" items={apis} />

  <Boxes subtitle="Covenants and Smart Contracts" items={contracts} />

  <Boxes subtitle="Protocols" items={protocols} />

  <Boxes subtitle="BCH Block Explorers" items={explorers} />

  <Boxes subtitle="Network Tools" items={network} />

  <Boxes subtitle="Utilities" items={utilities} />

  <Boxes subtitle="BCH Full Nodes" items={fullnodes} />

  <Boxes subtitle="Example Dapps" items={dapps} />

  <Boxes subtitle="CashTokens Tooling" items={cashtokensTooling} />

  <BlogLatestPosts title="Tutorials" category="Tutorial" />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <Features
    highlight=""
    title="Why learn to build on BCH"
    subtitle="A UTXO is a coin: a value, a lock and a serial number. You already understand it from cash. Bitcoin Cash lets you program the lock."
    items={[
      {
        title: 'UTXO skills are Bitcoin skills',
        icon: 'tabler:currency-bitcoin',
        description:
          'Script, coin selection, signing and fee math work the same way on Bitcoin. The model also carries over to Cardano, Kaspa, Ergo and Sui-style objects.',
      },
      {
        title: 'Tutorials cost a tenth of a cent',
        icon: 'tabler:receipt',
        description:
          'A mainnet test transaction costs about $0.001. You can break things on a real proof-of-work chain for pocket change, not $20 of gas.',
      },
      {
        title: 'Covenants you can run today',
        icon: 'tabler:lock-code',
        description:
          'Introspection opcodes let a contract check where its coins go. Vaults, allowances, escrow and recurring payments are live, not proposals.',
      },
      {
        title: 'More compute since 2025',
        icon: 'tabler:cpu',
        description:
          'The May 2025 upgrade replaced opcode counts with a density-based cost budget and added BigInt, so contracts can do arbitrary-precision math.',
      },
      {
        title: 'Loops and functions since 2026',
        icon: 'tabler:repeat',
        description:
          'The May 2026 upgrade added loops, reusable functions, bitwise ops and pay-to-script outputs. CashScript 0.13 supports loops, bitwise ops and P2S.',
      },
      {
        title: 'No admin keys, no approvals',
        icon: 'tabler:shield-check',
        description:
          'Covenants are fixed bytecode with no owner and no upgradeable proxy. Tokens are native, so there is no approve() for an attacker to abuse.',
      },
    ]}
  />

  <Features
    highlight=""
    title="The honest part"
    subtitle="What to expect before you commit your time."
    items={[
      {
        title: 'Harder than Solidity at first',
        icon: 'tabler:brain',
        description:
          'There is no global state to read and write. You design with coins that are spent and created, and shared pools need care to avoid contention.',
      },
      {
        title: 'A small ecosystem',
        icon: 'tabler:users',
        description:
          'Fewer developers, fewer libraries and thin liquidity. You will ship sooner and stand out more, but you will also answer your own questions more often.',
      },
      {
        title: 'Bugs are still bugs',
        icon: 'tabler:bug',
        description:
          'No admin keys means no one can patch a broken contract. Test on chipnet, step through the VM in Bitauth IDE and keep value limits low at launch.',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get BCH updates',
        href: 'https://t.me/bitcoincashsite',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Get builder updates</Fragment>
    <Fragment slot="subtitle">Upgrades, tools and tutorials for Bitcoin Cash builders, on Telegram.</Fragment>
  </CallToAction>
</Layout>
