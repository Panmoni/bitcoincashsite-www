---
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { type CopyList, getPageCopy } from "~/utils/pages";
import { getProjectsByCategory } from "~/utils/projects";

const copy = await getPageCopy("build");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };

const libraries = await getProjectsByCategory("build:library");
const docs = await getProjectsByCategory("build:docs");
const communities = await getProjectsByCategory("build:community");
const apis = await getProjectsByCategory("build:api");
const contracts = await getProjectsByCategory("build:contracts");
const protocols = await getProjectsByCategory("build:protocol");
const explorers = await getProjectsByCategory("build:explorer");
const network = await getProjectsByCategory("build:network");
const utilities = await getProjectsByCategory("build:utility");
const fullnodes = await getProjectsByCategory("build:fullnode");
const dapps = await getProjectsByCategory("build:dapp");
const cashtokensTooling = await getProjectsByCategory("cashtokens:devtool");
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">{copy.hero.title}</Fragment>
    <Fragment slot="subtitle">{copy.hero.subtitle}</Fragment>
  </InnerTitle>

  <Boxes
    title={copy.start.title}
    subtitle={copy.start.subtitle}
    highlight=""
    items={[...copy.start.featured, ...libraries]}
  />

  <Boxes subtitle={copy.categories.docs} items={docs} />

  <Boxes subtitle={copy.categories.communities} items={communities} />

  <Boxes subtitle={copy.categories.apis} items={apis} />

  <Boxes subtitle={copy.categories.contracts} items={contracts} />

  <Boxes subtitle={copy.categories.protocols} items={protocols} />

  <Boxes subtitle={copy.categories.explorers} items={explorers} />

  <Boxes subtitle={copy.categories.network} items={network} />

  <Boxes subtitle={copy.categories.utilities} items={utilities} />

  <Boxes subtitle={copy.categories.fullnodes} items={fullnodes} />

  <Boxes subtitle={copy.categories.dapps} items={dapps} />

  <Boxes subtitle={copy.categories.cashtokensTooling} items={cashtokensTooling} />

  <BlogLatestPosts title={copy.tutorials.title} category="Tutorial" />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title={copy.video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <Features
    highlight=""
    title={copy.why.title}
    subtitle={copy.why.subtitle}
    items={copy.why.items}
  />

  <!-- Spec sheet -->
  <section id="spec-sheet" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto grid gap-10">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <span class="wb-chip">{copy.specSheet.chip}</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">{copy.specSheet.title}</h2>
        </div>
        <p class="text-muted max-w-[46ch]">{copy.specSheet.intro}</p>
      </div>

      <div class="wb-card overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-[15px]">
          <thead class="bg-soft font-mono text-xs uppercase tracking-wider">
            <tr><th scope="col" class="p-4">{copy.specSheet.columns.param}</th><th scope="col" class="p-4">{copy.specSheet.columns.typ}</th><th scope="col" class="p-4">{copy.specSheet.columns.note}</th></tr>
          </thead>
          <tbody>
            {
              (copy.specSheet.rows as CopyList).map(({ param, typ, note }) => (
                <tr class="border-t-2 border-line">
                  <th scope="row" class="p-4 font-mono text-xs font-bold uppercase tracking-wider">{param}</th>
                  <td class="p-4 font-mono font-bold whitespace-nowrap tabular-nums">{typ}</td>
                  <td class="p-4 text-muted">{note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div>
        <h3 class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight mb-2">{copy.fee.title}</h3>
        <p class="text-muted mb-5">{copy.fee.intro}</p>
        <form class="wb-card overflow-hidden grid sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_1.3fr]" id="fee-calc">
          <label class="p-5 grid gap-2 border-b-2 lg:border-b-0 sm:border-r-2 border-line">
            <span class="wb-label">{copy.fee.bytes}</span>
            <input id="fee-bytes" type="number" value="226" min="100" step="1" class="font-mono text-xl font-bold border-2 border-line rounded-lg px-3 py-2 bg-page text-ink" />
          </label>
          <label class="p-5 grid gap-2 border-b-2 lg:border-b-0 lg:border-r-2 border-line">
            <span class="wb-label">{copy.fee.rate}</span>
            <input id="fee-rate" type="number" value="1" min="1" step="1" class="font-mono text-xl font-bold border-2 border-line rounded-lg px-3 py-2 bg-page text-ink" />
          </label>
          <label class="p-5 grid gap-2 border-b-2 sm:border-b-0 sm:border-r-2 border-line">
            <span class="wb-label">{copy.fee.price}</span>
            <input id="fee-price" type="number" value="450" min="1" step="1" class="font-mono text-xl font-bold border-2 border-line rounded-lg px-3 py-2 bg-page text-ink" />
          </label>
          <output for="fee-bytes fee-rate fee-price" class="p-5 grid gap-1 content-start bg-wb-yellow text-on-accent">
            <span class="font-mono text-xs font-medium uppercase tracking-wider opacity-75">{copy.fee.result}</span>
            <span id="fee-usd" class="font-mono text-4xl font-bold tabular-nums leading-none">{copy.fee.initialUsd}</span>
            <span id="fee-sats" class="font-mono text-sm">{copy.fee.initialSats}</span>
          </output>
        </form>
      </div>

      <div>
        <h3 class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight mb-2">{copy.limits.title}</h3>
        <p class="text-muted mb-5">{copy.limits.intro}</p>
        <div class="wb-card overflow-x-auto">
          <table class="w-full min-w-[640px] text-left text-[15px]">
            <thead class="bg-soft font-mono text-xs uppercase tracking-wider">
              <tr><th scope="col" class="p-4">{copy.limits.columns.rating}</th><th scope="col" class="p-4">{copy.limits.columns.status}</th><th scope="col" class="p-4">{copy.limits.columns.why}</th></tr>
            </thead>
            <tbody>
              {
                (copy.limits.rows as CopyList).map(({ rating, status, why }) => (
                  <tr class="border-t-2 border-line">
                    <th scope="row" class="p-4 font-mono text-xs font-bold uppercase tracking-wider">{rating}</th>
                    <td class="p-4 font-mono font-bold whitespace-nowrap">{status}</td>
                    <td class="p-4 text-muted">{why}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <Features
    highlight=""
    title={copy.honest.title}
    subtitle={copy.honest.subtitle}
    items={copy.honest.items}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: copy.cta.action,
        href: 'https://t.me/bchworks',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">{copy.cta.title}</Fragment>
    <Fragment slot="subtitle">{copy.cta.subtitle}</Fragment>
  </CallToAction>
</Layout>

<script>
  function initFeeCalc() {
    const form = document.getElementById("fee-calc");
    if (!form) return;
    const num = (id: string) => Number((document.getElementById(id) as HTMLInputElement | null)?.value) || 0;
    const update = () => {
      const sats = num("fee-bytes") * num("fee-rate");
      const usd = (sats / 1e8) * num("fee-price");
      const usdEl = document.getElementById("fee-usd");
      const satsEl = document.getElementById("fee-sats");
      if (usdEl) usdEl.textContent = `$${usd < 0.01 ? usd.toFixed(4) : usd.toFixed(2)}`;
      if (satsEl) satsEl.textContent = `${sats.toLocaleString()} sats`;
    };
    form.addEventListener("input", update);
    form.addEventListener("submit", (e) => e.preventDefault());
    update();
  }

  initFeeCalc();
  document.addEventListener("astro:after-swap", initFeeCalc);
</script>
