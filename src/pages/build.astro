---
import BlogLatestPosts from "~/components/widgets/BlogLatestPosts.astro";
import Boxes from "~/components/widgets/Boxes.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Features from "~/components/widgets/Features.astro";
import Hero from "~/components/widgets/Hero.astro";
import InnerTitle from "~/components/widgets/InnerTitle.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getProjectsByCategory } from "~/utils/projects";

const metadata = {
	title: "Build on Bitcoin Cash: Covenants, CashTokens and UTXO Contracts",
	description:
		"Bitcoin Cash is the cheapest place to learn and ship Bitcoin-style contracts. Loops, functions, BigInt and native tokens are live on mainnet, and a test transaction costs about $0.001.",
	ignoreTitleTemplate: true,
};

const libraries = await getProjectsByCategory("build:library");
const docs = await getProjectsByCategory("build:docs");
const communities = await getProjectsByCategory("build:community");
const apis = await getProjectsByCategory("build:api");
const contracts = await getProjectsByCategory("build:contracts");
const protocols = await getProjectsByCategory("build:protocol");
const explorers = await getProjectsByCategory("build:explorer");
const network = await getProjectsByCategory("build:network");
const utilities = await getProjectsByCategory("build:utility");
const fullnodes = await getProjectsByCategory("build:fullnode");
const dapps = await getProjectsByCategory("build:dapp");
const cashtokensTooling = await getProjectsByCategory("cashtokens:devtool");

const specs = [
	{
		param: "Relay fee",
		typ: "1 sat/byte",
		note: "Flat per byte. No auction, so no spike at peak load.",
	},
	{
		param: "Payment size",
		typ: "~226 bytes",
		note: "1 input, 2 outputs (P2PKH).",
	},
	{
		param: "Time to seen",
		typ: "~2 s",
		note: "Relayed with double-spend proofs and a risk score.",
	},
	{ param: "Block interval", typ: "10 min", note: "Same target as Bitcoin." },
	{
		param: "Block size limit",
		typ: "32 MB floor",
		note: "Adaptive since 2024: grows with sustained demand.",
	},
	{
		param: "Integers",
		typ: "BigInt",
		note: "Arbitrary-precision math since May 2025.",
	},
	{
		param: "Control flow",
		typ: "Loops, functions",
		note: "Since May 2026, with bitwise ops and P2S outputs.",
	},
	{
		param: "Tokens",
		typ: "Native",
		note: "Fungible tokens and NFTs inside UTXOs. No contract deploy.",
	},
	{
		param: "Upgrade cadence",
		typ: "Yearly, May 15",
		note: "Six months on chipnet first.",
	},
];

const limits = [
	{
		rating: "Global shared-state contracts",
		status: "Not supported",
		why: "By design. A contract is a lock on a coin.",
	},
	{
		rating: "Sub-second finality",
		status: "Not supported",
		why: "Blocks average 10 minutes.",
	},
	{
		rating: "Privacy by default",
		status: "Not supported",
		why: "Transparent ledger. CashFusion is opt-in.",
	},
	{
		rating: "Deep liquidity",
		status: "Low",
		why: "DeFi is measured in millions, not billions.",
	},
	{
		rating: "USDT / USDC on L1",
		status: "Not available",
		why: "An issuer decision, not a protocol limit.",
	},
	{
		rating: "Hash rate vs. Bitcoin",
		status: "Small fraction",
		why: "Same SHA-256 algorithm, far less work.",
	},
];
---

<Layout metadata={metadata}>
  <InnerTitle>
    <Fragment slot="title">Bitcoin's covenant lab, live on mainnet.</Fragment>
    <Fragment slot="subtitle">The contract ideas Bitcoin still debates already run on Bitcoin Cash. Learn them here, where a test transaction costs about $0.001.</Fragment>
  </InnerTitle>

  <Boxes
    title="Start building"
    subtitle="CashScript for contracts, Libauth and Bitauth IDE to step through the VM, mainnet-js for wallets and tokens. All open source."
    highlight=""
    items={[
      {
        title: 'CashTokens Ecosystem',
        description: 'Explore the CashTokens ecosystem.',
        icon: 'https://static.panmoni.com/bitcoincashsite/cashtokenslogo.png',
        url: '/cashtokens',
      },
      ...libraries,
    ]}
  />

  <Boxes subtitle="BCH Documentation" items={docs} />

  <Boxes subtitle="Builder Communities" items={communities} />

  <Boxes subtitle="APIs" items={apis} />

  <Boxes subtitle="Covenants and Smart Contracts" items={contracts} />

  <Boxes subtitle="Protocols" items={protocols} />

  <Boxes subtitle="BCH Block Explorers" items={explorers} />

  <Boxes subtitle="Network Tools" items={network} />

  <Boxes subtitle="Utilities" items={utilities} />

  <Boxes subtitle="BCH Full Nodes" items={fullnodes} />

  <Boxes subtitle="Example Dapps" items={dapps} />

  <Boxes subtitle="CashTokens Tooling" items={cashtokensTooling} />

  <BlogLatestPosts title="Tutorials" category="Tutorial" />

  <Hero>
    <Fragment slot="image">
      <div class="relative h-0 pb-[56.25%]">
        <iframe
          width="560"
          height="315"
          src="https://www.youtube.com/embed/arFDrjx_2JY"
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture;"
          allowfullscreen
          class="absolute top-0 left-0 w-full h-full"
        >
        </iframe>
      </div>
    </Fragment>
  </Hero>

  <Features
    highlight=""
    title="Why learn to build on BCH"
    subtitle="A UTXO is a coin: a value, a lock and a serial number. You already understand it from cash. Bitcoin Cash lets you program the lock."
    items={[
      {
        title: 'UTXO skills are Bitcoin skills',
        icon: 'tabler:currency-bitcoin',
        description:
          'Script, coin selection, signing and fee math work the same way on Bitcoin. The model also carries over to Cardano, Kaspa, Ergo and Sui-style objects.',
      },
      {
        title: 'Tutorials cost a tenth of a cent',
        icon: 'tabler:receipt',
        description:
          'A mainnet test transaction costs about $0.001. You can break things on a real proof-of-work chain for pocket change, not $20 of gas.',
      },
      {
        title: 'Covenants you can run today',
        icon: 'tabler:lock-code',
        description:
          'Introspection opcodes let a contract check where its coins go. Vaults, allowances, escrow and recurring payments are live, not proposals.',
      },
      {
        title: 'More compute since 2025',
        icon: 'tabler:cpu',
        description:
          'The May 2025 upgrade replaced opcode counts with a density-based cost budget and added BigInt, so contracts can do arbitrary-precision math.',
      },
      {
        title: 'Loops and functions since 2026',
        icon: 'tabler:repeat',
        description:
          'The May 2026 upgrade added loops, reusable functions, bitwise ops and pay-to-script outputs. CashScript 0.13 supports loops, bitwise ops and P2S.',
      },
      {
        title: 'No admin keys, no approvals',
        icon: 'tabler:shield-check',
        description:
          'Covenants are fixed bytecode with no owner and no upgradeable proxy. Tokens are native, so there is no approve() for an attacker to abuse.',
      },
    ]}
  />

  <!-- Spec sheet -->
  <section id="spec-sheet" class="px-4 sm:px-6 py-14 md:py-16 scroll-mt-24">
    <div class="max-w-7xl mx-auto grid gap-10">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <span class="wb-chip">Spec sheet · rev. 2026-05</span>
          <h2 class="mt-3 font-heading text-4xl md:text-6xl font-extrabold leading-none tracking-[-0.04em]">The numbers you design against.</h2>
        </div>
        <p class="text-muted max-w-[46ch]">Typical mainnet values, and the limits to design around. Datasheets list their limits, and so does this one.</p>
      </div>

      <div class="wb-card overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-[15px]">
          <thead class="bg-soft font-mono text-xs uppercase tracking-wider">
            <tr><th scope="col" class="p-4">Parameter</th><th scope="col" class="p-4">Typical</th><th scope="col" class="p-4">Notes</th></tr>
          </thead>
          <tbody>
            {
              specs.map(({ param, typ, note }) => (
                <tr class="border-t-2 border-line">
                  <th scope="row" class="p-4 font-mono text-xs font-bold uppercase tracking-wider">{param}</th>
                  <td class="p-4 font-mono font-bold whitespace-nowrap tabular-nums">{typ}</td>
                  <td class="p-4 text-muted">{note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div>
        <h3 class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight mb-2">Work out a fee.</h3>
        <p class="text-muted mb-5">Fee = bytes × sat/byte. Change the example price to your own.</p>
        <form class="wb-card overflow-hidden grid sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1fr_1.3fr]" id="fee-calc">
          <label class="p-5 grid gap-2 border-b-2 lg:border-b-0 sm:border-r-2 border-line">
            <span class="wb-label">Tx size (bytes)</span>
            <input id="fee-bytes" type="number" value="226" min="100" step="1" class="font-mono text-xl font-bold border-2 border-line rounded-lg px-3 py-2 bg-page text-ink" />
          </label>
          <label class="p-5 grid gap-2 border-b-2 lg:border-b-0 lg:border-r-2 border-line">
            <span class="wb-label">Fee rate (sat/byte)</span>
            <input id="fee-rate" type="number" value="1" min="1" step="1" class="font-mono text-xl font-bold border-2 border-line rounded-lg px-3 py-2 bg-page text-ink" />
          </label>
          <label class="p-5 grid gap-2 border-b-2 sm:border-b-0 sm:border-r-2 border-line">
            <span class="wb-label">BCH price, USD (example)</span>
            <input id="fee-price" type="number" value="450" min="1" step="1" class="font-mono text-xl font-bold border-2 border-line rounded-lg px-3 py-2 bg-page text-ink" />
          </label>
          <output for="fee-bytes fee-rate fee-price" class="p-5 grid gap-1 content-start bg-wb-yellow text-on-accent">
            <span class="font-mono text-xs font-medium uppercase tracking-wider opacity-75">Network fee</span>
            <span id="fee-usd" class="font-mono text-4xl font-bold tabular-nums leading-none">$0.0010</span>
            <span id="fee-sats" class="font-mono text-sm">226 sats</span>
          </output>
        </form>
      </div>

      <div>
        <h3 class="font-heading text-2xl md:text-3xl font-extrabold tracking-tight mb-2">Limits to design around.</h3>
        <p class="text-muted mb-5">True today. We update this list when a limit changes.</p>
        <div class="wb-card overflow-x-auto">
          <table class="w-full min-w-[640px] text-left text-[15px]">
            <thead class="bg-soft font-mono text-xs uppercase tracking-wider">
              <tr><th scope="col" class="p-4">Limit</th><th scope="col" class="p-4">Status</th><th scope="col" class="p-4">Why</th></tr>
            </thead>
            <tbody>
              {
                limits.map(({ rating, status, why }) => (
                  <tr class="border-t-2 border-line">
                    <th scope="row" class="p-4 font-mono text-xs font-bold uppercase tracking-wider">{rating}</th>
                    <td class="p-4 font-mono font-bold whitespace-nowrap">{status}</td>
                    <td class="p-4 text-muted">{why}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <Features
    highlight=""
    title="The honest part"
    subtitle="What to expect before you commit your time."
    items={[
      {
        title: 'Harder than Solidity at first',
        icon: 'tabler:brain',
        description:
          'There is no global state to read and write. You design with coins that are spent and created, and shared pools need care to avoid contention.',
      },
      {
        title: 'A small ecosystem',
        icon: 'tabler:users',
        description:
          'Fewer developers, fewer libraries and thin liquidity. You will ship sooner and stand out more, but you will also answer your own questions more often.',
      },
      {
        title: 'Bugs are still bugs',
        icon: 'tabler:bug',
        description:
          'No admin keys means no one can patch a broken contract. Test on chipnet, step through the VM in Bitauth IDE and keep value limits low at launch.',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get BCH updates',
        href: 'https://t.me/bitcoincashsite',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title">Get builder updates</Fragment>
    <Fragment slot="subtitle">Upgrades, tools and tutorials for Bitcoin Cash builders, on Telegram.</Fragment>
  </CallToAction>
</Layout>

<script>
  function initFeeCalc() {
    const form = document.getElementById("fee-calc");
    if (!form) return;
    const num = (id: string) => Number((document.getElementById(id) as HTMLInputElement | null)?.value) || 0;
    const update = () => {
      const sats = num("fee-bytes") * num("fee-rate");
      const usd = (sats / 1e8) * num("fee-price");
      const usdEl = document.getElementById("fee-usd");
      const satsEl = document.getElementById("fee-sats");
      if (usdEl) usdEl.textContent = `$${usd < 0.01 ? usd.toFixed(4) : usd.toFixed(2)}`;
      if (satsEl) satsEl.textContent = `${sats.toLocaleString()} sats`;
    };
    form.addEventListener("input", update);
    form.addEventListener("submit", (e) => e.preventDefault());
    update();
  }

  initFeeCalc();
  document.addEventListener("astro:after-swap", initFeeCalc);
</script>
