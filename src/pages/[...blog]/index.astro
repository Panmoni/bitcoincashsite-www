---
import type {
	GetStaticPaths,
	ImageMetadata,
	InferGetStaticPropsType,
} from "astro";
import merge from "lodash.merge";
import SinglePost from "~/components/blog/SinglePost.astro";
import Layout from "~/layouts/PageLayout.astro";
import type { MetaData } from "~/types";
import { blogPostRobots, getStaticPathsBlogPost } from "~/utils/blog";
import { findImage } from "~/utils/images";
import { getCanonical, getPermalink } from "~/utils/permalinks";

export const prerender = true;

export const getStaticPaths = (async () => {
	return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = getCanonical(getPermalink(post.permalink, "post"));
const image = (await findImage(post.image)) as
	| ImageMetadata
	| string
	| undefined;

const metadata = merge(
	{
		title: post.title,
		description: post.excerpt,
		robots: {
			index: blogPostRobots?.index,
			follow: blogPostRobots?.follow,
		},
		openGraph: {
			type: "article",
			...(image
				? {
						images: [
							{
								url: image,
								width: (image as ImageMetadata)?.width,
								height: (image as ImageMetadata)?.height,
							},
						],
					}
				: {}),
		},
	},
	{
		...(post?.metadata
			? { ...post.metadata, canonical: post.metadata?.canonical || url }
			: {}),
	},
) as MetaData;

const imageUrl = image
	? String(new URL(typeof image === "string" ? image : image.src, Astro.site))
	: undefined;
const postLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description: post.excerpt,
	mainEntityOfPage: String(url),
	...(imageUrl ? { image: imageUrl } : {}),
	...(post.publishDate ? { datePublished: post.publishDate.toISOString() } : {}),
	dateModified: (post.updateDate ?? post.publishDate)?.toISOString(),
	author: post.author
		? { "@type": "Person", name: post.author }
		: { "@type": "Organization", name: "BCH Works", url: "https://bchworks.com" },
	publisher: {
		"@type": "Organization",
		name: "BCH Works",
		url: "https://bchworks.com",
		logo: {
			"@type": "ImageObject",
			url: "https://bchworks.com/android-chrome-512x512.png",
		},
	},
};
---

<Layout metadata={metadata}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(postLd)} />
  <SinglePost post={{ ...post, image: image }} />
</Layout>
