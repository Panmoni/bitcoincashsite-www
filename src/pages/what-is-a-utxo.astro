---
import Freshness from "~/components/reference/Freshness.astro";
import UtxoCharts from "~/components/utxo/UtxoCharts.astro";
import UtxoMachine from "~/components/utxo/UtxoMachine.astro";
import Layout from "~/layouts/PageLayout.astro";
import { getPageCopy } from "~/utils/pages";
import { faqJsonLd, isoDate } from "~/utils/reference";

const copy = await getPageCopy("what-is-a-utxo");
const metadata = { ...copy.metadata, ignoreTitleTemplate: true };
const verified = new Date("2026-09-26");

const faq = copy.faq.items;

const article = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: metadata.title,
	description: metadata.description,
	inLanguage: "en",
	dateModified: isoDate(verified),
	author: {
		"@type": "Organization",
		name: "BCH Works",
		url: "https://bchworks.com",
	},
	publisher: { "@type": "Organization", name: "BCH Works" },
};
const faqLd = faqJsonLd(faq);
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <header class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-14">
    <p class="wb-chip mb-4">{copy.hero.chip}</p>
    <h1 class="font-heading text-4xl md:text-6xl font-extrabold leading-[1.05] tracking-[-0.04em] max-w-4xl">
      {copy.hero.title}
    </h1>
    <p class="mt-4 text-xl text-muted max-w-3xl">
      {copy.hero.subtitle}
    </p>
    <div class="mt-4"><Freshness date={verified} /></div>
  </header>

  <UtxoMachine presets={copy.presets} />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:tracking-tight prose-a:underline">
      <h2>{copy.article.coin.title}</h2>
      <p set:html={copy.article.coin.body} />
      <h2>{copy.article.spending.title}</h2>
      <p set:html={copy.article.spending.body} />
      <p set:html={copy.article.spending.fee} />
      <h2>{copy.article.tree.title}</h2>
      <p set:html={copy.article.tree.body} />
      <h2>{copy.article.why.title}</h2>
      <ul>
        {copy.article.why.items.map((item: string) => <li set:html={item} />)}
      </ul>
      <p set:html={copy.article.why.tradeoff} />
    </div>
  </article>

  <UtxoCharts />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-14">
    <h2 class="font-heading text-3xl font-extrabold tracking-tight mb-4">{copy.faq.title}</h2>
    <div class="space-y-3">
      {
        faq.map(({ q, a }: { q: string; a: string }) => (
          <details class="wb-card p-4">
            <summary class="font-bold cursor-pointer">{q}</summary>
            <p class="mt-2 text-muted">{a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-muted" set:html={copy.sources} />
  </section>
</Layout>
