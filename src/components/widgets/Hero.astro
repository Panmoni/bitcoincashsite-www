---
import Image from "~/components/common/Image.astro";
import Button from "~/components/ui/Button.astro";
import type { CallToAction } from "~/types";

export interface Props {
	id?: string;
	title?: string;
	subtitle?: string;
	tagline?: string;
	content?: string;
	actions?: string | CallToAction[];
	image?: string | any; // TODO: find HTMLElementProps
}

const {
	id,
	title = await Astro.slots.render("title"),
	subtitle = await Astro.slots.render("subtitle"),
	tagline,
	content = await Astro.slots.render("content"),
	actions = await Astro.slots.render("actions"),
	image = await Astro.slots.render("image"),
} = Astro.props;
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div
      class:list={[
        'py-12 md:py-16 grid gap-10 lg:gap-14 items-center',
        { 'lg:grid-cols-[1.05fr_1fr]': image && (title || subtitle) },
      ]}
    >
      {
        (tagline || title || subtitle || actions || content) && (
          <div class:list={[{ 'max-w-4xl': !image }]}>
            {tagline && <p class="wb-chip mb-5" set:html={tagline} />}
            {title && (
              <h1
                class="font-heading text-5xl md:text-7xl font-extrabold leading-[0.95] tracking-[-0.045em] mb-5"
                set:html={title}
              />
            )}
            {subtitle && <p class="text-xl text-muted mb-8 max-w-[38ch]" set:html={subtitle} />}
            {actions && (
              <div class="flex flex-col sm:flex-row flex-wrap gap-4">
                {Array.isArray(actions) ? (
                  actions.map((action) => <Button {...(action || {})} class="w-full sm:w-auto" />)
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )}
            {content && <Fragment set:html={content} />}
          </div>
        )
      }
      {
        image && (
          <div class:list={['relative w-full', { 'max-w-5xl mx-auto': !(title || subtitle) }]}>
            <div class="wb-card shadow-hard-lg overflow-hidden">
              <div class="flex items-center gap-1.5 px-3 py-2.5 border-b-2 border-line bg-soft" aria-hidden="true">
                <i class="w-2.5 h-2.5 rounded-full bg-wb-pink"></i>
                <i class="w-2.5 h-2.5 rounded-full bg-wb-yellow"></i>
                <i class="w-2.5 h-2.5 rounded-full bg-wb-green"></i>
              </div>
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  width={1024}
                  height={576}
                  {...image}
                />
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
