---
// icon > image and add link
import Freshness from "~/components/reference/Freshness.astro";

interface Item {
	title?: string;
	description?: string;
	icon?: string;
	url?: string;
	// Directory entries: when a person last checked it, and the daily health state.
	verified?: Date;
	state?: "alive" | "stale" | "dead" | "unknown";
}

export interface Props {
	title?: string;
	subtitle?: string;
	highlight?: string;
	items: Array<Item>;
}

const {
	title = await Astro.slots.render("title"),
	subtitle = await Astro.slots.render("subtitle"),
	highlight,
	items = [],
} = Astro.props;
---

<section class="relative not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-10">
    {
      (title || highlight) && (
        <div class="mb-8 max-w-3xl">
          {highlight && <p class="wb-chip mb-3" set:html={highlight} />}
          {title && (
            <h2
              class="font-heading text-4xl md:text-5xl font-extrabold leading-[1.02] md:leading-none tracking-[-0.04em]"
              set:html={title}
            />
          )}
          {subtitle && <p class="mt-4 text-xl text-muted" set:html={subtitle} />}
        </div>
      )
    }
    {
      !(title || highlight) && subtitle && (
        <h3 class="mb-5 flex items-center gap-3 font-heading text-2xl md:text-3xl font-extrabold tracking-tight">
          <span aria-hidden="true" class="w-3 h-3 rounded-xs border-2 border-line bg-wb-green"></span>
          <span set:html={subtitle} />
        </h3>
      )
    }
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 items-stretch">
      {
        items.map(({ title, description, icon, url, verified, state }) => {
          const Tag = url ? 'a' : 'div';
          return (
            <Tag
              class:list={['wb-card min-w-0 flex flex-col gap-3 p-5', { 'wb-card-hover': url }]}
              {...(url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <div class="flex items-center gap-3">
                {icon && (
                  <img
                    src={icon}
                    class="w-11 h-11 shrink-0 rounded-lg border-2 border-line bg-white object-contain p-1"
                    alt=""
                    loading="lazy"
                  />
                )}
                <span class="min-w-0 wrap-break-word font-heading text-lg sm:text-xl font-extrabold tracking-tight leading-snug sm:leading-7">{title}</span>
              </div>
              {description && <p class="text-muted text-[15px]">{description}</p>}
              {url && (
                <span class="mt-auto pt-1 font-mono text-xs text-muted truncate">
                  $ open {url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                </span>
              )}
              {(verified || state) && (
                <span class:list={['flex flex-wrap items-center gap-2', { 'mt-auto': !url }]}>
                  <Freshness date={verified} />
                  {state === 'stale' && (
                    <span class="rounded-sm border-2 border-line bg-wb-yellow px-1.5 font-mono text-[11px] font-bold uppercase text-on-accent" title="Site answers, but the code has not moved in a year">
                      stale
                    </span>
                  )}
                </span>
              )}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>
