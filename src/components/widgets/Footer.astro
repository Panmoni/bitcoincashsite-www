---
import Logo from "~/components/Logo.astro";
import { SITE } from "~/utils/config";
import { getHomePermalink } from "~/utils/permalinks";

interface Link {
	text?: string;
	href?: string;
	ariaLabel?: string;
	icon?: string;
}

interface Links {
	title?: string;
	links: Array<Link>;
}

export interface Props {
	links: Array<Links>;
	secondaryLinks: Array<Link>;
	socialLinks: Array<Link>;
	footNote?: string;
	theme?: string;
}

const {
	socialLinks = [],
	secondaryLinks = [],
	links = [],
	footNote = "",
	theme = "light",
} = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose px-4 pt-12 pb-8']}>
  <div class="relative max-w-7xl mx-auto text-default">
    <div class="grid grid-cols-12 gap-6 gap-y-10 pb-10">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block" href={getHomePermalink()} aria-label={SITE?.name}><Logo /></a>
        <p class="mt-3 max-w-[26ch] text-muted">Build your prosperity with Bitcoin Cash.</p>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="font-mono text-xs font-bold uppercase tracking-wider mb-3">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="grid gap-2 text-[15px]">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted hover:text-ink hover:underline decoration-wb-green decoration-[3px] underline-offset-4"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 border-t-2 border-line pt-5 font-mono text-xs text-muted">
      <span>
        © 2020–{new Date().getFullYear()} George Donnelly / Panmoni.{' '}
        <a
          class="underline hover:text-ink"
          href="https://creativecommons.org/licenses/by/4.0/"
          target="_blank"
          rel="noopener noreferrer license">CC-BY</a
        >
      </span>
      {
        secondaryLinks.map(({ text, href }) => (
          <a class="hover:text-ink hover:underline" href={href} set:html={text} />
        ))
      }
      {
        socialLinks?.length ? (
          <ul class="flex gap-1 md:ml-auto">
            {socialLinks.map(({ ariaLabel, href, text }) => (
              <li>
                <a class="hover:text-ink hover:bg-soft rounded-lg p-2 inline-flex items-center" aria-label={ariaLabel} href={href}>
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
      {footNote && <span class="md:ml-auto" set:html={footNote} />}
    </div>
  </div>
</footer>
