---
export interface Props {
	title?: string;
	subtitle?: string;
}

const {
	title = await Astro.slots.render("title"),
	subtitle = await Astro.slots.render("subtitle"),
} = Astro.props;
---

<section class="relative not-prose px-4 sm:px-6 pt-6 md:pt-10">
  <div class="relative max-w-7xl mx-auto">
    <div class="wb-card shadow-hard-lg bg-wb-green text-on-accent px-6 py-10 md:px-12 md:py-16 overflow-hidden relative">
      <div
        aria-hidden="true"
        class="absolute inset-0 opacity-25 bg-[radial-gradient(rgb(var(--wb-on-accent))_1.2px,transparent_1.2px)] bg-size-[22px_22px]"
      >
      </div>
      <div class="relative max-w-4xl">
        {
          title && (
            <h1
              class="font-heading text-5xl md:text-7xl font-extrabold leading-[0.95] md:leading-none tracking-[-0.045em]"
              set:html={title}
            />
          )
        }
        {subtitle && <p class="mt-5 text-xl md:text-2xl max-w-[44ch]" set:html={subtitle} />}
      </div>
      <span
        aria-hidden="true"
        class="hidden md:inline-flex absolute right-10 top-8 rotate-6 wb-card shadow-hard-sm bg-wb-yellow text-on-accent font-mono text-xs font-bold px-3 py-2"
        >BCH</span
      >
      <span
        aria-hidden="true"
        class="hidden md:inline-flex absolute right-24 bottom-8 -rotate-6 wb-card shadow-hard-sm bg-wb-pink text-on-accent font-mono text-xs font-bold px-3 py-2"
        >&lt;1¢ fees</span
      >
    </div>
  </div>
</section>
