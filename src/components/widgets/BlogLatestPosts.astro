---
import Grid from "~/components/blog/Grid.astro";
import WidgetWrapper from "~/components/ui/WidgetWrapper.astro";
import type { Widget } from "~/types";
import { findLatestPosts } from "~/utils/blog";
import { APP_BLOG } from "~/utils/config";
import { getBlogPermalink } from "~/utils/permalinks";
import Button from "../ui/Button.astro";

export interface Props extends Widget {
	title?: string;
	linkText?: string;
	linkUrl?: string | URL;
	information?: string;
	count?: number;
	category?: string;
	tag?: string;
}

const {
	title = await Astro.slots.render("title"),
	linkText = "View all posts",
	linkUrl = getBlogPermalink(),
	information = await Astro.slots.render("information"),
	count = 4,
	category,
	tag,

	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render("bg"),
} = Astro.props;

const posts = APP_BLOG.isEnabled
	? await findLatestPosts({ count, category, tag })
	: [];
---

{
  APP_BLOG.isEnabled ? (
    <WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container} bg={bg}>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between mb-8">
        {title && (
          <div>
            <p class="wb-chip mb-3">Blog</p>
            <h2
              class="font-heading text-4xl md:text-5xl font-extrabold leading-[1.02] md:leading-none tracking-[-0.04em]"
              set:html={title}
            />
          </div>
        )}
        <div class="flex flex-col gap-3 lg:items-end">
          {information && <p class="text-muted lg:max-w-md lg:text-right" set:html={information} />}
          {APP_BLOG.list.isEnabled && linkText && linkUrl && (
            <Button href={linkUrl} class="py-2.5 px-4 md:px-4 text-sm shadow-hard-sm">
              {linkText} →
            </Button>
          )}
        </div>
      </div>
      <Grid posts={posts} />
    </WidgetWrapper>
  ) : (
    <Fragment />
  )
}
