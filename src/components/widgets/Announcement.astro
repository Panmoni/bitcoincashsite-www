---
import { m, msg } from "~/i18n/messages";

const l = msg(Astro.currentLocale);
---

<div class="hidden md:block px-4 pt-3">
  <div class="max-w-7xl mx-auto flex items-center gap-3 text-sm overflow-hidden whitespace-nowrap text-ellipsis">
    <span class="wb-chip">{m.widget_announcement_new({}, l)}</span>
    <a href="/bitcoin-cash" target="_blank" rel="noopener" class="font-mono font-medium text-ink hover:underline decoration-wb-green decoration-[3px] underline-offset-4"
      >{m.widget_announcement_why_bch({}, l)}</a
    >
  </div>
</div>
