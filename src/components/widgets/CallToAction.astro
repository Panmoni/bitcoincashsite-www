---
import Button from "~/components/ui/Button.astro";
import Headline from "~/components/ui/Headline.astro";
import type { CallToAction, Widget } from "~/types";
import WidgetWrapper from "../ui/WidgetWrapper.astro";

interface Props extends Widget {
	title?: string;
	subtitle?: string;
	tagline?: string;
	callToAction?: CallToAction;
	actions?: string | CallToAction[];
}

const {
	title = await Astro.slots.render("title"),
	subtitle = await Astro.slots.render("subtitle"),
	tagline = await Astro.slots.render("tagline"),
	actions = await Astro.slots.render("actions"),

	id,
	isDark = false,
	classes = {},
	bg = await Astro.slots.render("bg"),
} = Astro.props as Props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div class="rounded-[18px] bg-ink text-page px-6 py-10 md:px-12 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: 'text-4xl md:text-5xl text-page',
        subtitle: 'text-lg text-page/70',
      }}
    />
    {
      actions && (
        <div class="flex flex-col sm:flex-row flex-wrap gap-4 shrink-0">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <Button {...(action || {})} class="w-full sm:w-auto shadow-[4px_4px_0_rgb(var(--wb-green))]" />
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
