---
import Button from "~/components/ui/Button.astro";

const {
	title = await Astro.slots.render("title"),
	subtitle = await Astro.slots.render("subtitle"),
	tagline,
	content = await Astro.slots.render("content"),
	callToAction = await Astro.slots.render("callToAction"),
	callToAction2 = await Astro.slots.render("callToAction2"),
} = Astro.props;
---

<section class="relative not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-12 md:pt-16 pb-8 max-w-4xl">
      {tagline && <p class="wb-chip mb-5" set:html={tagline} />}
      {
        title && (
          <h1
            class="font-heading text-5xl md:text-7xl font-extrabold leading-[0.95] tracking-[-0.045em] mb-5"
            set:html={title}
          />
        )
      }
      {subtitle && <p class="text-xl text-muted mb-8 max-w-[42ch]" set:html={subtitle} />}
      <div class="flex flex-col sm:flex-row flex-wrap gap-4">
        {
          callToAction &&
            (typeof callToAction === 'string' ? (
              <Fragment set:html={callToAction} />
            ) : (
              <Button variant="primary" {...callToAction} />
            ))
        }
        {
          callToAction2 &&
            (typeof callToAction2 === 'string' ? <Fragment set:html={callToAction2} /> : <Button {...callToAction2} />)
        }
      </div>
      {content && <Fragment set:html={content} />}
    </div>
  </div>
</section>
