---
// BCH chain vitals from the nightly snapshot, as server-rendered stat tiles.
import Freshness from "~/components/reference/Freshness.astro";
import { m, msg } from "~/i18n/messages";
import { count, metrics, usd } from "~/utils/reference";

const l = msg(Astro.currentLocale);
const bch = metrics.chains.bch;
const tiles = [
	{ label: m.ref_vitals_block_height({}, l), value: count(bch.height) },
	{ label: m.ref_vitals_tx_24h({}, l), value: count(bch.tx24h) },
	{ label: m.ref_vitals_median_fee({}, l), value: usd(bch.medianFeeUsd) },
	{ label: m.ref_vitals_blocks_24h({}, l), value: count(bch.blocks24h) },
	{
		label: m.ref_vitals_hashrate({}, l),
		value: bch.hashrate ? `${(bch.hashrate / 1e18).toFixed(2)} EH/s` : "n/a",
	},
	{ label: m.ref_vitals_nodes({}, l), value: count(bch.nodes) },
];
---

<section class="not-prose my-8">
  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
    <h2 class="font-heading text-xl font-extrabold tracking-tight">{m.ref_vitals_heading({}, l)}</h2>
    <Freshness date={metrics.generatedAt} label={m.ref_snapshot({}, l)} freshDays={2} agingDays={7} />
  </div>
  <dl class="grid grid-cols-2 md:grid-cols-3 gap-3">
    {
      tiles.map((t) => (
        <div class="wb-card p-4">
          <dt class="font-mono text-xs uppercase text-muted">{t.label}</dt>
          <dd class="font-heading text-2xl font-extrabold mt-1">{t.value}</dd>
        </div>
      ))
    }
  </dl>
  <p class="mt-2 text-xs text-muted">
    {m.ref_vitals_source({}, l)} <a class="underline" href="https://blockchair.com/bitcoin-cash" target="_blank" rel="noopener noreferrer">Blockchair</a>{m.ref_vitals_refreshed_daily({}, l)}
  </p>
</section>
