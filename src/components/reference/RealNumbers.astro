---
// "The Real Numbers": BCH next to other chains, from the nightly snapshot.
// Static text so it indexes; the badge says how old the numbers are.
import Freshness from "~/components/reference/Freshness.astro";
import { type ChainId, count, metrics, usd } from "~/utils/reference";

export interface Props {
	compare?: ChainId[];
	title?: string;
}

const { compare = ["btc", "ltc", "eth", "sol"], title = "The Real Numbers" } =
	Astro.props;
const ids: ChainId[] = ["bch", ...compare.filter((c) => c !== "bch")];
const rows = ids.map((id) => ({ id, ...metrics.chains[id] }));
const averaged = rows.filter((r) => r.feeBasis === "average");
---

<section class="not-prose wb-card p-5 my-8 overflow-hidden">
  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
    <h2 class="font-heading text-2xl font-extrabold tracking-tight">{title}</h2>
    <Freshness date={metrics.generatedAt} label="Snapshot" freshDays={2} agingDays={7} />
  </div>
  <div class="overflow-x-auto -mx-5 px-5">
    <table class="w-full min-w-[520px] text-sm">
      <thead class="text-left font-mono text-xs text-muted">
        <tr>
          <th class="py-2 pr-3">Chain</th>
          <th class="py-2 pr-3 text-right">Median fee</th>
          <th class="py-2 pr-3 text-right">Tx / 24h</th>
          <th class="py-2 pr-3 text-right">Block time</th>
          <th class="py-2 text-right">Market cap</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr class:list={['border-t-2 border-line/20', { 'font-bold': r.id === 'bch' }]}>
              <td class="py-2 pr-3">{r.name}</td>
              <td class="py-2 pr-3 text-right font-mono">{usd(r.medianFeeUsd)}{r.feeBasis === 'average' && '†'}</td>
              <td class="py-2 pr-3 text-right font-mono">{count(r.tx24h)}</td>
              <td class="py-2 pr-3 text-right font-mono">{r.blockTime}</td>
              <td class="py-2 text-right font-mono">{usd(r.marketCapUsd)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-muted">
    Sources: <a class="underline" href="https://blockchair.com" rel="noopener noreferrer" target="_blank">Blockchair</a> (fees, transactions),
    <a class="underline" href="https://www.coingecko.com" rel="noopener noreferrer" target="_blank">CoinGecko</a> (market cap),
    <a class="underline" href="https://solana.com/docs/rpc" rel="noopener noreferrer" target="_blank">Solana RPC</a>,
    <a class="underline" href="https://api.kaspa.org" rel="noopener noreferrer" target="_blank">Kaspa API</a> and
    <a class="underline" href="https://koios.rest" rel="noopener noreferrer" target="_blank">Koios</a>.
    {ids.includes('sol') && 'Solana counts exclude validator votes.'}
    {ids.includes('kas') && 'Kaspa counts cover the last full UTC day.'}
    {averaged.length > 0 && `† ${averaged.map((r) => r.name).join(", ")}: average fee over the last full epoch; no free source gives a median.`}
    "n/a" means no free public source we trust for that number yet. Block times are protocol targets.
  </p>
</section>
