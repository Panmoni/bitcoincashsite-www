---
// import { Icon } from 'astro-icon/components';

import PostTags from "~/components/blog/Tags.astro";
import Image from "~/components/common/Image.astro";
import Button from "~/components/ui/Button.astro";
import type { Post } from "~/types";
import { getBlogPermalink, getPermalink } from "~/utils/permalinks";
import { getFormattedDate } from "~/utils/utils";

export interface Props {
	post: Post;
}

const { post } = Astro.props;
const { Content } = post;
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-16 lg:py-20">
  <article>
    <header class:list={['grid gap-8 lg:gap-12 items-center', { 'lg:grid-cols-2': post.image }]}>
      <div class="min-w-0">
        <p class="wb-chip bg-surface text-ink">
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.updateDate && (
              <>
                {' '}· Updated{' '}
                <time datetime={String(post.updateDate)} class="inline-block">{getFormattedDate(post.updateDate)}</time>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="capitalize hover:underline inline-block" href={getPermalink(post.category, 'category')}>
                  {post.category.replaceAll('-', ' ')}
                </a>
              </>
            )
          }
          {post.readingTime && <> · {post.readingTime} min read</>}
        </p>
        <h1
          class="mt-4 max-w-4xl text-4xl md:text-6xl lg:text-5xl xl:text-6xl font-extrabold leading-none tracking-[-0.04em] font-heading wrap-break-word"
        >
          {post.title}
        </h1>
        <p class="mt-4 max-w-[48ch] text-xl md:text-2xl text-muted">
          {post.excerpt}
        </p>
      </div>
      {
        post.image && (
          <Image
            src={post.image}
            class="w-full wb-card shadow-hard-lg bg-soft"
            widths={[400, 768, 900]}
            sizes="(max-width: 1023px) calc(100vw - 2rem), 600px"
            alt={post?.excerpt || ''}
            width={900}
            height={506}
            loading="eager"
            decoding="async"
          />
        )
      }
    </header>
    <div class="mt-10 md:mt-14 border-t-2 border-line"></div>
    <div class="mt-8 md:mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <div class="min-w-0 prose prose-lg lg:prose-xl max-w-none prose-headings:scroll-mt-[100px]">
        {Content ? <Content /> : <Fragment set:html={post.content || ''} />}
      </div>
      <aside class="lg:sticky lg:top-28 self-start flex flex-col gap-6">
        {post.tags?.length ? <PostTags tags={post.tags} /> : null}
        <Button href={getBlogPermalink()}>← Back to Blog</Button>
      </aside>
    </div>
  </article>
</section>

<a
  id="back-to-top"
  href="#"
  aria-label="Back to top"
  class="hidden btn fixed z-30 bottom-4 right-4 sm:bottom-6 sm:right-6 !px-4 !py-3 text-sm"
>
  ↑ <span class="hidden sm:inline">Top</span>
</a>

<script>
  const link = document.getElementById('back-to-top');
  if (link) {
    const toggle = () => link.classList.toggle('hidden', window.scrollY < 600);
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }

  // Give every code block a toolbar with its language and a Copy button.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const code = pre.querySelector('code') ?? pre;
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = document.createElement('span');
    lang.textContent = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'code';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        btn.textContent = 'Copied ✓';
      } catch {
        // Clipboard blocked: select the code so the reader can copy it by hand.
        getSelection()?.selectAllChildren(code);
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
    bar.append(lang, btn);
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.replaceWith(wrap);
    wrap.append(bar, pre);
  }
</script>

<style is:global>
  /* Code block chrome, in the style of the homepage's code window. */
  .prose .code-block {
    margin-block: 1.6em;
    border: 2px solid rgb(var(--wb-line));
    border-radius: 14px;
    box-shadow: 4px 4px 0 rgb(var(--wb-line));
    overflow: hidden;
    background: #0f1216;
  }
  .prose .code-block pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0.5rem 0.4rem 1rem;
    background: #1a1f26;
    border-bottom: 2px solid rgb(var(--wb-line));
    font-family: var(--aw-font-mono), monospace;
    font-size: 0.75rem;
    color: #7f8a97;
  }
  .code-bar button {
    font: inherit;
    font-weight: 700;
    color: #0f1216;
    background: rgb(var(--wb-green));
    border: 2px solid #0f1216;
    border-radius: 999px;
    padding: 0.15rem 0.75rem;
    cursor: pointer;
  }
  .code-bar button:hover {
    background: rgb(var(--wb-yellow));
  }
  .code-bar button:focus-visible {
    outline: 3px solid rgb(var(--wb-blue));
    outline-offset: 2px;
  }
</style>
