---
import Button from "~/components/ui/Button.astro";
// import { Icon } from 'astro-icon/components';
import { m, msg } from "~/i18n/messages";
import { getPermalink } from "~/utils/permalinks";

export interface Props {
	prevUrl?: string;
	nextUrl?: string;
	prevText?: string;
	nextText?: string;
}

const l = msg(Astro.currentLocale);

const {
	prevUrl,
	nextUrl,
	prevText = m.blog_pagination_newer({}, l),
	nextText = m.blog_pagination_older({}, l),
} = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <div class="container flex mt-10 md:mt-14">
      <div class="flex flex-row mx-auto container justify-between">
        <Button
          class={`mr-2 ${!prevUrl ? 'invisible' : ''}`}
          href={getPermalink(prevUrl)}
        >
          <span>← {prevText}</span>
        </Button>

        <Button class={`${!nextUrl ? 'invisible' : ''}`} href={getPermalink(nextUrl)}>
          <span>{nextText} →</span>
        </Button>
      </div>
    </div>
  )
}
