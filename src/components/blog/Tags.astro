---
import type { Post } from "~/types";

import { APP_BLOG } from "~/utils/config";
import { getPermalink } from "~/utils/permalinks";

export interface Props {
	tags: Post["tags"];
	class?: string;
	title?: string | undefined;
	isCategory?: boolean;
}

const {
	tags,
	class: className = "text-sm",
	title = undefined,
	isCategory = false,
} = Astro.props;
---

{
  tags && Array.isArray(tags) && (
    <>
      <>
        {title !== undefined && (
          <span class="wb-chip mr-2 rtl:mr-0 rtl:ml-2 align-middle">
            {title}
          </span>
        )}
      </>
      <ul class={className}>
        {tags.map((tag) => (
          <li class="inline-block mr-2 rtl:mr-0 rtl:ml-2 mb-2 py-1 px-2.5 rounded-full border-2 border-line bg-surface font-mono text-xs lowercase font-medium">
            {!APP_BLOG?.tag?.isEnabled ? (
              tag
            ) : (
              <a
                href={getPermalink(tag, isCategory ? 'category' : 'tag')}
                class="text-ink hover:underline decoration-wb-green decoration-2 underline-offset-2"
              >
                {tag}
              </a>
            )}
          </li>
        ))}
      </ul>
    </>
  )
}
