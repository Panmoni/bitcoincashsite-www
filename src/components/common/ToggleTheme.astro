---
import { Icon } from "astro-icon/components";

import { UI } from "~/utils/config";

export interface Props {
	label?: string;
	class?: string;
	iconClass?: string;
}

const {
	label = "Toggle between Dark and Light mode",
	class:
		className = "text-muted hover:text-ink hover:bg-soft rounded-lg text-sm p-2.5 inline-flex items-center",
	iconClass = "w-5 h-5",
} = Astro.props;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <button type="button" class={className} aria-label={label} data-aw-toggle-color-scheme>
      <Icon name="tabler:sun" class={`${iconClass} dark:hidden`} />
      <Icon name="tabler:moon" class={`${iconClass} hidden dark:block`} />
    </button>
  )
}
