---
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { findImage } from "~/utils/images";

// Resolves "~/assets/images/..." strings, then hands local images to Astro's
// optimizer. Other strings (remote or /public URLs) render as a plain <img>.
type Props = Omit<HTMLAttributes<"img">, "src" | "width" | "height"> & {
	src?: string | ImageMetadata | null;
	alt: string;
	width?: number;
	height?: number;
	widths?: number[];
};

const { src, widths, ...props } = Astro.props;
const image = await findImage(src);
---

{
	image && typeof image === "object" ? (
		<AstroImage src={image} widths={widths} {...props} />
	) : image ? (
		<img src={image} loading="lazy" decoding="async" {...props} />
	) : null
}
