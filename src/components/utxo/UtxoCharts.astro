---
// UTXO-set analytics from our own BCHN node: supply by coin age, coin-days
// destroyed, and dormant-coin awakenings. Tiles and tables render at build
// (they index and work without JS); the three charts draw in the browser
// from the weekly series embedded below.
import Freshness from "~/components/reference/Freshness.astro";
import { short } from "~/components/utxo/story";
import {
	hasStats,
	recentAwakenings,
	summary,
	topAwakenings,
	utxoStats,
	weeklySeries,
} from "~/utils/utxo-stats";

const s = summary();
const weekly = hasStats ? weeklySeries() : null;
const top = topAwakenings(10);
const recent = recentAwakenings(8);
const fmt = (n: number, d = 0) =>
	n.toLocaleString("en-US", { maximumFractionDigits: d });
const compact = (n: number) =>
	n.toLocaleString("en-US", { notation: "compact", maximumFractionDigits: 1 });
const old = s ? s.bands[s.bands.length - 1] : null;
const bandLabels = utxoStats.bands.map((b) => b.label);
---

<section id="utxo-set" class="not-prose max-w-7xl mx-auto px-4 sm:px-6 py-10" aria-labelledby="us-title">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 id="us-title" class="font-heading text-3xl md:text-5xl font-extrabold tracking-tight">The whole UTXO set, from our own node</h2>
    {utxoStats.generatedAt && <Freshness date={utxoStats.generatedAt} label="Computed" freshDays={2} agingDays={7} />}
  </div>
  <p class="mt-3 text-lg text-muted max-w-3xl">
    Every coin that exists, grouped by how long it has sat still. We compute this ourselves from a Bitcoin Cash Node,
    and check our count against the node's own <code class="font-mono text-base">coinstatsindex</code> total every day.
    No third-party analytics API.
  </p>

  {
    !s || !weekly ? (
      <div class="wb-card p-6 mt-6">
        <p class="font-heading text-xl font-extrabold">The node pipeline has not published yet.</p>
        <p class="mt-2 text-muted max-w-2xl">
          These charts come from <code class="font-mono">scripts/utxo-stats.mjs</code> run against a BCHN node with
          <code class="font-mono">-coinstatsindex</code>. The machine above works now: it reads the chain live.
        </p>
      </div>
    ) : (
      <>
        <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="wb-card p-4">
            <dt class="wb-label">Supply at block {fmt(s.height)}</dt>
            <dd class="font-heading text-3xl font-extrabold mt-1">{fmt(s.supply)} BCH</dd>
            <dd class="text-sm text-muted mt-1">Matches the node's coinstatsindex to the satoshi.</dd>
          </div>
          {old && (
            <div class="wb-card p-4">
              <dt class="wb-label">Unmoved 7+ years</dt>
              <dd class="font-heading text-3xl font-extrabold mt-1">{fmt((old.bch / s.supply) * 100, 1)}%</dd>
              <dd class="text-sm text-muted mt-1">{fmt(old.bch)} BCH, untouched since {Number(s.date.slice(0, 4)) - 7} or earlier.</dd>
            </div>
          )}
          <div class="wb-card p-4">
            <dt class="wb-label">Coin-days destroyed, 30 days</dt>
            <dd class="font-heading text-3xl font-extrabold mt-1">{compact(s.cdd30)}</dd>
            <dd class="text-sm text-muted mt-1">BCH moved × days each coin had waited.</dd>
          </div>
          <div class="wb-card p-4">
            <dt class="wb-label">Awakenings, 30 days</dt>
            <dd class="font-heading text-3xl font-extrabold mt-1">{s.awakenings30}</dd>
            <dd class="text-sm text-muted mt-1">Transactions moving 10+ BCH that slept 3+ years.</dd>
          </div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Time range for all charts">
          {[
            ["split", "Since the 2017 split"],
            ["all", "All history"],
            ["5y", "5 years"],
            ["1y", "1 year"],
          ].map(([k, label], i) => (
            <button type="button" class="us-range font-mono text-xs border-2 border-line rounded-full px-3 py-1.5" data-range={k} aria-pressed={i === 0 ? "true" : "false"}>
              {label}
            </button>
          ))}
        </div>

        <figure class="wb-card p-4 md:p-6 mt-4">
          <figcaption>
            <h3 class="font-heading text-2xl font-extrabold tracking-tight">Who holds the supply: coins by age</h3>
            <p class="text-sm text-muted mt-1">Share of all BCH, by how long each coin has gone unspent. Weekly.</p>
          </figcaption>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Legend">
            {bandLabels.map((l, i) => (
              <li class="flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-sm" style={`background: var(--us-b${i})`} />
                {l}
              </li>
            ))}
          </ul>
          <div class="us-chart relative mt-3" data-chart="waves" style="height: 320px" />
        </figure>

        <figure class="wb-card p-4 md:p-6 mt-6">
          <figcaption>
            <h3 class="font-heading text-2xl font-extrabold tracking-tight">Coin-days destroyed, per week</h3>
            <p class="text-sm text-muted mt-1">
              Each spend destroys its coin-days: BCH × days since the coin last moved. Spikes mean old coins moved.
            </p>
          </figcaption>
          <div class="us-chart relative mt-3" data-chart="cdd" style="height: 260px" />
        </figure>

        <figure class="wb-card p-4 md:p-6 mt-6">
          <figcaption>
            <h3 class="font-heading text-2xl font-extrabold tracking-tight">Zombie coins waking up</h3>
            <p class="text-sm text-muted mt-1">
              Each dot is one transaction that moved 10+ BCH of coins asleep 3+ years. Higher means a longer sleep; bigger
              means more BCH.
            </p>
          </figcaption>
          <div class="us-chart relative mt-3" data-chart="awake" style="height: 280px" />
        </figure>

        <div class="grid gap-6 lg:grid-cols-2 mt-6">
          {[
            ["Largest awakenings", top],
            ["Latest awakenings", recent],
          ].map(([title, list]) => (
            <div class="wb-card p-4 md:p-6 overflow-x-auto">
              <h3 class="font-heading text-xl font-extrabold tracking-tight">{title as string}</h3>
              <table class="w-full mt-3 text-sm min-w-[420px]">
                <thead class="text-left font-mono text-xs text-muted">
                  <tr>
                    <th class="py-1.5 pr-3">Woke up</th>
                    <th class="py-1.5 pr-3 text-right">BCH</th>
                    <th class="py-1.5 pr-3">Asleep since</th>
                    <th class="py-1.5">Transaction</th>
                  </tr>
                </thead>
                <tbody>
                  {(list as typeof top).map((a) => (
                    <tr class="border-t-2 border-line/20">
                      <td class="py-1.5 pr-3 font-mono">{a.date}</td>
                      <td class="py-1.5 pr-3 font-mono text-right">{fmt(a.sats / 1e8, 2)}</td>
                      <td class="py-1.5 pr-3">{a.since} <span class="text-muted">({a.years} y)</span></td>
                      <td class="py-1.5">
                        <a class="underline font-mono" href={`?tx=${a.txid}#machine`}>{short(a.txid)}</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </>
    )
  }

  <details class="wb-card p-4 mt-6">
    <summary class="font-bold cursor-pointer">How we compute this</summary>
    <div class="mt-3 space-y-2 text-muted max-w-3xl">
      <p>
        We read every block from genesis with <code class="font-mono">getblock</code> verbosity 3, which lists each input's
        prevout height and value. Each output adds its value to the day it was born. Each input takes its value back out
        and destroys value × age coin-days. Ages count whole UTC days, by block median time.
      </p>
      <p>
        At the end of each day we ask the node for its UTXO-set total with <code class="font-mono">gettxoutsetinfo</code>,
        served by <code class="font-mono">-coinstatsindex</code>. If our count differs by one satoshi, the job fails
        instead of publishing. OP_RETURN outputs and the two BIP30 duplicate coinbases are excluded, as the node excludes
        them.
      </p>
      <p>
        We skip the newest {utxoStats.source?.confirmations ?? 6} blocks, so a reorg cannot reach the data. Coins born before
        August 1, 2017 exist on both BCH and BTC; "7+ years" includes coins that never moved after the split.
      </p>
      {utxoStats.source && <p class="font-mono text-xs">Node: {utxoStats.source.node}</p>}
    </div>
  </details>
</section>

{weekly && <script type="application/json" id="us-data" set:html={JSON.stringify({ ...weekly, labels: bandLabels, awake: utxoStats.awakenings.map((a) => [a.date, a.years, a.sats / 1e8, a.txid]) })} />}

<style is:global>
  :root {
    --us-b0: #86b6ef;
    --us-b1: #5598e7;
    --us-b2: #2a78d6;
    --us-b3: #1c5cab;
    --us-b4: #104281;
    --us-line: #256abf;
  }
  .dark {
    --us-b0: #256abf;
    --us-b1: #3987e5;
    --us-b2: #6da7ec;
    --us-b3: #9ec5f4;
    --us-b4: #cde2fb;
    --us-line: #6da7ec;
  }
  .us-range[aria-pressed="true"] { background: rgb(var(--wb-ink)); color: rgb(var(--wb-bg)); }
  .us-chart svg { display: block; overflow: visible; }
  .us-chart text { fill: rgb(var(--wb-muted)); font-family: var(--aw-font-mono, ui-monospace); font-size: 11px; }
  .us-grid { stroke: rgb(var(--wb-soft)); stroke-width: 1; }
  .us-tip {
    position: absolute;
    pointer-events: none;
    z-index: 10;
    min-width: 11rem;
    background: rgb(var(--wb-surface));
    color: rgb(var(--wb-ink));
    border: 2px solid rgb(var(--wb-line));
    border-radius: 10px;
    box-shadow: 3px 3px 0 rgb(var(--wb-line));
    padding: 0.5rem 0.65rem;
    font-size: 0.75rem;
  }
  .us-tip b { font-family: var(--aw-font-mono, ui-monospace); }
  .us-key { display: inline-block; width: 12px; height: 2px; vertical-align: middle; margin-right: 6px; }
</style>

<script>
  type Data = {
    dates: string[];
    supply: number[];
    cdd: number[];
    revived: number[];
    bands: number[][];
    labels: string[];
    awake: Array<[string, number, number, string]>;
  };
  const node = document.getElementById("us-data");
  if (node) {
    const data = JSON.parse(node.textContent ?? "{}") as Data;
    const NS = "http://www.w3.org/2000/svg";
    const M = { top: 10, right: 12, bottom: 26, left: 52 };
    let range = "split";

    const svgEl = (tag: string, attrs: Record<string, string | number>) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      return e;
    };
    const t = (d: string) => Date.parse(`${d}T00:00:00Z`);
    const compact = (n: number) => n.toLocaleString("en-US", { notation: "compact", maximumFractionDigits: 1 });
    const fromDate = () => {
      const last = t(data.dates[data.dates.length - 1]);
      const year = 365.25 * 86400000;
      return { split: t("2017-08-01"), all: 0, "5y": last - 5 * year, "1y": last - year }[range] ?? 0;
    };

    function frame(host: HTMLElement) {
      host.replaceChildren();
      const w = host.clientWidth;
      const h = host.clientHeight;
      const svg = svgEl("svg", { width: w, height: h, role: "img" });
      host.append(svg);
      const tip = document.createElement("div");
      tip.className = "us-tip";
      tip.hidden = true;
      host.append(tip);
      return { svg, tip, w, h, iw: w - M.left - M.right, ih: h - M.top - M.bottom };
    }

    function xAxis(svg: SVGElement, x: (ms: number) => number, t0: number, t1: number, ih: number, iw: number) {
      const y0 = new Date(t0).getUTCFullYear();
      const y1 = new Date(t1).getUTCFullYear();
      const every = Math.max(1, Math.ceil((y1 - y0 + 1) / Math.max(2, Math.floor(iw / 70))));
      for (let y = y0 + 1; y <= y1; y += every) {
        const px = x(Date.UTC(y, 0, 1));
        const label = svgEl("text", { x: px, y: M.top + ih + 18, "text-anchor": "middle" });
        label.textContent = String(y);
        svg.append(label);
      }
    }

    function yAxis(svg: SVGElement, ticks: number[], y: (v: number) => number, fmt: (v: number) => string, iw: number) {
      for (const v of ticks) {
        svg.append(svgEl("line", { class: "us-grid", x1: M.left, x2: M.left + iw, y1: y(v), y2: y(v) }));
        const label = svgEl("text", { x: M.left - 8, y: y(v) + 4, "text-anchor": "end" });
        label.textContent = fmt(v);
        svg.append(label);
      }
    }

    function niceTicks(max: number) {
      const step0 = max / 4;
      const mag = 10 ** Math.floor(Math.log10(step0 || 1));
      const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= step0) ?? step0;
      return [0, step, 2 * step, 3 * step, 4 * step].filter((v) => v <= max * 1.05);
    }

    function place(tip: HTMLElement, host: HTMLElement, px: number, py: number) {
      tip.hidden = false;
      const left = px + 14 + tip.offsetWidth > host.clientWidth ? px - tip.offsetWidth - 14 : px + 14;
      tip.style.left = `${Math.max(0, left)}px`;
      tip.style.top = `${Math.max(0, py - tip.offsetHeight / 2)}px`;
    }

    function row(tip: HTMLElement, color: string, value: string, label: string) {
      const r = document.createElement("div");
      const key = document.createElement("span");
      key.className = "us-key";
      key.style.background = color;
      const b = document.createElement("b");
      b.textContent = value;
      r.append(key, b, document.createTextNode(` ${label}`));
      tip.append(r);
    }

    function head(tip: HTMLElement, text: string) {
      const p = document.createElement("p");
      p.className = "text-muted mb-1";
      p.textContent = text;
      tip.replaceChildren(p);
    }

    // Crosshair hover shared by the two time-series charts.
    function crosshair(host: HTMLElement, svg: SVGElement, tip: HTMLElement, xs: number[], ih: number, show: (i: number) => void) {
      const line = svgEl("line", { x1: 0, x2: 0, y1: M.top, y2: M.top + ih, stroke: "rgb(var(--wb-ink))", "stroke-width": 1, visibility: "hidden", "pointer-events": "none" });
      // One transparent hit layer on top: the pointer never lands on a moving mark.
      const hit = svgEl("rect", { x: M.left, y: M.top, width: xs[xs.length - 1] - M.left, height: ih, fill: "transparent" });
      svg.append(line, hit);
      const move = (clientX: number) => {
        const r = svg.getBoundingClientRect();
        const px = clientX - r.left;
        let best = 0;
        for (let i = 1; i < xs.length; i++) if (Math.abs(xs[i] - px) < Math.abs(xs[best] - px)) best = i;
        line.setAttribute("x1", String(xs[best]));
        line.setAttribute("x2", String(xs[best]));
        line.setAttribute("visibility", "visible");
        show(best);
        place(tip, host, xs[best], M.top + ih / 2);
      };
      svg.addEventListener("pointermove", (e) => move(e.clientX));
      svg.addEventListener("pointerleave", () => {
        tip.hidden = true;
        line.setAttribute("visibility", "hidden");
      });
    }

    function slice() {
      const from = fromDate();
      const idx = data.dates.map((d, i) => (t(d) >= from ? i : -1)).filter((i) => i >= 0);
      return idx;
    }

    function waves(host: HTMLElement) {
      const { svg, tip, iw, ih } = frame(host);
      const idx = slice();
      if (idx.length < 2) return;
      const t0 = t(data.dates[idx[0]]);
      const t1 = t(data.dates[idx[idx.length - 1]]);
      const x = (ms: number) => M.left + ((ms - t0) / (t1 - t0 || 1)) * iw;
      const y = (share: number) => M.top + ih - share * ih;
      yAxis(svg, [0, 0.25, 0.5, 0.75, 1], y, (v) => `${v * 100}%`, iw);
      const xs = idx.map((i) => x(t(data.dates[i])));
      const shares = idx.map((i) => {
        const tot = data.bands.reduce((a, b) => a + b[i], 0) || 1;
        return data.bands.map((b) => b[i] / tot);
      });
      // Oldest band at the bottom, like sediment.
      const order = data.bands.map((_, b) => data.bands.length - 1 - b);
      const base = idx.map(() => 0);
      for (const b of order) {
        const top = base.map((v, k) => v + shares[k][b]);
        const d = `M${xs.map((px, k) => `${px},${y(top[k])}`).join("L")}L${xs
          .map((px, k) => `${px},${y(base[k])}`)
          .reverse()
          .join("L")}Z`;
        svg.append(svgEl("path", { d, fill: `var(--us-b${b})`, stroke: "rgb(var(--wb-surface))", "stroke-width": 1, "stroke-linejoin": "round" }));
        top.forEach((v, k) => {
          base[k] = v;
        });
      }
      xAxis(svg, x, t0, t1, ih, iw);
      svg.setAttribute("aria-label", "Stacked area chart: share of BCH supply by coin age over time. Hover for values.");
      crosshair(host, svg, tip, xs, ih, (k) => {
        const i = idx[k];
        head(tip, data.dates[i]);
        for (const b of [...order].reverse()) row(tip, `var(--us-b${b})`, `${(shares[k][b] * 100).toFixed(1)}%`, data.labels[b]);
        row(tip, "transparent", `${Math.round(data.supply[i]).toLocaleString("en-US")} BCH`, "total");
      });
    }

    function cdd(host: HTMLElement) {
      const { svg, tip, iw, ih } = frame(host);
      const idx = slice();
      if (idx.length < 2) return;
      const t0 = t(data.dates[idx[0]]);
      const t1 = t(data.dates[idx[idx.length - 1]]);
      const max = Math.max(...idx.map((i) => data.cdd[i]), 1);
      const ticks = niceTicks(max);
      const top = Math.max(ticks[ticks.length - 1], max);
      const x = (ms: number) => M.left + ((ms - t0) / (t1 - t0 || 1)) * iw;
      const y = (v: number) => M.top + ih - (v / top) * ih;
      yAxis(svg, ticks, y, compact, iw);
      const xs = idx.map((i) => x(t(data.dates[i])));
      const d = `M${xs.map((px, k) => `${px},${y(data.cdd[idx[k]])}`).join("L")}`;
      svg.append(svgEl("path", { d, fill: "none", stroke: "var(--us-line)", "stroke-width": 2, "stroke-linejoin": "round" }));
      xAxis(svg, x, t0, t1, ih, iw);
      svg.setAttribute("aria-label", "Line chart: coin-days destroyed per week. Hover for values.");
      crosshair(host, svg, tip, xs, ih, (k) => {
        const i = idx[k];
        head(tip, `Week to ${data.dates[i]}`);
        row(tip, "var(--us-line)", compact(data.cdd[i]), "coin-days destroyed");
        row(tip, "transparent", `${compact(data.revived[i])} BCH`, "moved after 3+ years");
      });
    }

    function awake(host: HTMLElement) {
      const { svg, tip, iw, ih } = frame(host);
      const from = fromDate();
      const pts = data.awake.filter((a) => t(a[0]) >= from);
      const t0 = Math.max(from, t(data.dates[0]));
      const t1 = t(data.dates[data.dates.length - 1]);
      const maxY = Math.max(10, ...pts.map((p) => p[1]));
      const ticks = niceTicks(maxY);
      const top = Math.max(ticks[ticks.length - 1], maxY);
      const x = (ms: number) => M.left + ((ms - t0) / (t1 - t0 || 1)) * iw;
      const y = (v: number) => M.top + ih - (v / top) * ih;
      yAxis(svg, ticks, y, (v) => `${v}y`, iw);
      xAxis(svg, x, t0, t1, ih, iw);
      const maxB = Math.max(1, ...pts.map((p) => p[2]));
      svg.setAttribute("aria-label", `Scatter chart: ${pts.length} awakenings. Hover a dot for details; the tables below list them.`);
      for (const p of pts) {
        const cx = x(t(p[0]));
        const cy = y(p[1]);
        const r = 4 + 12 * Math.sqrt(p[2] / maxB);
        const g = svgEl("g", { tabindex: 0, role: "link", "aria-label": `${p[0]}: ${p[2].toFixed(2)} BCH asleep ${p[1]} years` });
        g.append(
          svgEl("circle", { cx, cy, r, fill: "var(--us-line)", "fill-opacity": 0.55, stroke: "rgb(var(--wb-surface))", "stroke-width": 2 }),
          svgEl("circle", { cx, cy, r: Math.max(r, 12), fill: "transparent" }),
        );
        const show = () => {
          head(tip, p[0]);
          row(tip, "var(--us-line)", `${p[2].toLocaleString("en-US", { maximumFractionDigits: 2 })} BCH`, `asleep ${p[1]} years`);
          const hint = document.createElement("p");
          hint.className = "text-muted mt-1";
          hint.textContent = "Click to run it in the machine";
          tip.append(hint);
          place(tip, host, cx, cy);
        };
        g.addEventListener("pointerenter", show);
        g.addEventListener("focus", show);
        g.addEventListener("pointerleave", () => (tip.hidden = true));
        g.addEventListener("blur", () => (tip.hidden = true));
        const open = () => {
          location.href = `?tx=${p[3]}#machine`;
        };
        g.addEventListener("click", open);
        g.addEventListener("keydown", (e) => {
          if ((e as KeyboardEvent).key === "Enter") open();
        });
        svg.append(g);
      }
    }

    const charts = { waves, cdd, awake } as Record<string, (h: HTMLElement) => void>;
    const hosts = [...document.querySelectorAll<HTMLElement>(".us-chart")];
    const drawAll = () => {
      for (const h of hosts) charts[h.dataset.chart ?? ""]?.(h);
    };
    for (const b of document.querySelectorAll<HTMLButtonElement>(".us-range")) {
      b.addEventListener("click", () => {
        range = b.dataset.range ?? "split";
        for (const o of document.querySelectorAll(".us-range")) o.setAttribute("aria-pressed", o === b ? "true" : "false");
        drawAll();
      });
    }
    let lastW = 0;
    new ResizeObserver(() => {
      const w = hosts[0]?.clientWidth ?? 0;
      if (w !== lastW) {
        lastW = w;
        drawAll();
      }
    }).observe(hosts[0]);
  }
</script>
