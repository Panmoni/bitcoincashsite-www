---
// import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";
import type { ItemGrid } from "~/types";
import Button from "./Button.astro";

const { items = [], columns, classes = {} } = Astro.props as ItemGrid;

const {
	container: containerClass = "",
	// container: containerClass = "sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
	panel: panelClass = "",
	title: titleClass = "",
	description: descriptionClass = "",
} = classes;
---

{
  items && (
    <div
      class={twMerge(
        `grid gap-5 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, callToAction, classes: itemClasses = {} }) => (
        <div class={twMerge('relative flex flex-col', panelClass, itemClasses?.panel)}>
          <h3 class={twMerge('font-heading text-2xl font-extrabold tracking-tight leading-tight', titleClass, itemClasses?.title)}>{title}</h3>
          {description && (
            <p class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)} set:html={description} />
          )}
          {callToAction && (
            <div class="mt-auto pt-4">
              <Button {...callToAction} />
            </div>
          )}
        </div>
      ))}
    </div>
  )
}
