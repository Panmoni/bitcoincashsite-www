---
import { twMerge } from "tailwind-merge";
import type { Headline } from "~/types";

const {
	title = await Astro.slots.render("title"),
	subtitle = await Astro.slots.render("subtitle"),
	tagline,
	classes = {},
} = Astro.props as Headline;

const {
	container: containerClass = "max-w-3xl",
	title: titleClass = "text-4xl md:text-5xl",
	subtitle: subtitleClass = "text-lg md:text-xl",
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge("mb-8 md:mb-10 max-w-3xl text-left rtl:text-right", containerClass)}>
      {tagline && <p class="wb-chip mb-3" set:html={tagline} />}
      {title && (
        <h2
          class={twMerge(
            "font-heading font-extrabold leading-[1.02] tracking-[-0.04em] text-heading",
            titleClass
          )}
          set:html={title}
        />
      )}
      {subtitle && <p class={twMerge("mt-4 text-muted", subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
