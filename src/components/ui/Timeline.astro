---
import { Icon } from "astro-icon/components";
import { twMerge } from "tailwind-merge";
import type { Item } from "~/types";

export interface Props {
	items?: Array<Item>;
	classes?: Record<string, string>;
}

const { items = [], classes = {} } = Astro.props as Props;

const {
	container: containerClass = "",
	panel: panelClass = "",
	title: titleClass = "",
	description: descriptionClass = "",
} = classes;
---

{
  items && items.length && (
    <ol class={twMerge('grid gap-4', containerClass)}>
      {items.map(({ title, description, icon, classes: itemClasses = {} }, index = 0) => {
        const isLast = index === items.length - 1;
        return (
          <li
            class={twMerge(
              'wb-card flex items-start gap-4 p-5',
              isLast ? 'bg-wb-green text-on-accent' : '',
              panelClass,
              itemClasses?.panel
            )}
          >
            <span
              aria-hidden="true"
              class={`grid place-items-center shrink-0 w-10 h-10 rounded-full border-2 border-line font-mono text-sm font-bold ${isLast ? 'bg-surface text-ink' : 'bg-page'}`}
            >
              {icon ? <Icon name={icon} class="w-5 h-5" /> : index + 1}
            </span>
            <div class="pt-1.5">
              {title && (
                <p
                  class={twMerge('font-heading text-xl font-extrabold tracking-tight leading-snug', titleClass, itemClasses?.title)}
                  set:html={title}
                />
              )}
              {description && (
                <p
                  class={twMerge(isLast ? 'mt-1.5' : 'text-muted mt-1.5', descriptionClass, itemClasses?.description)}
                  set:html={description}
                />
              )}
            </div>
          </li>
        );
      })}
    </ol>
  )
}
