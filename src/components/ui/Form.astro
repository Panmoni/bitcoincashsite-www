---
import Button from "~/components/ui/Button.astro";
import type { Form } from "~/types";

const {
	inputs,
	textarea,
	disclaimer,
	button = "Contact us",
	description = "",
} = Astro.props as Form;
---

<form>
  {
    inputs &&
      inputs.map(
        ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '' }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block font-mono text-xs font-bold uppercase tracking-wide">
                  {label}
                </label>
              )}
              <input
                type={type}
                name={name}
                id={name}
                autocomplete={autocomplete}
                placeholder={placeholder}
                class="mt-1.5 py-3 px-4 block w-full text-md rounded-[10px] border-2 border-line bg-page text-ink placeholder:text-muted"
              />
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block font-mono text-xs font-bold uppercase tracking-wide">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name="textarea"
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="mt-1.5 py-3 px-4 block w-full text-md rounded-[10px] border-2 border-line bg-page text-ink placeholder:text-muted"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 w-4 h-4 accent-[rgb(var(--wb-green))]"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-muted">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">{button}</Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-muted">{description}</p>
      </div>
    )
  }
</form>
