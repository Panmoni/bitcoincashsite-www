---
import "~/assets/styles/tailwind.css";

import CustomStyles from "~/components/CustomStyles.astro";
import ApplyColorMode from "~/components/common/ApplyColorMode.astro";
import BasicScripts from "~/components/common/BasicScripts.astro";
import CommonMeta from "~/components/common/CommonMeta.astro";
import Metadata from "~/components/common/Metadata.astro";
import SiteVerification from "~/components/common/SiteVerification.astro";
import Favicons from "~/components/Favicons.astro";
import { getLocale, htmlAttrs } from "~/i18n/locales";
import { m, msg } from "~/i18n/messages";
import type { MetaData as MetaDataType } from "~/types";
import { SITE } from "~/utils/config";

export interface Props {
	metadata?: MetaDataType;
	// Overrides the locale's language for a page written in another one.
	lang?: string;
}

const { metadata = {}, lang } = Astro.props;
const html = htmlAttrs(getLocale(Astro.currentLocale));
const l = msg(Astro.currentLocale);

// BreadcrumbList for pages one level under a hub, e.g. /upgrades/2026-05-upgrade.
const hubs: Record<string, string> = {
	blog: m.nav_blog({}, l),
	upgrades: m.nav_upgrades({}, l),
	chips: "CHIPs",
	opcodes: m.nav_opcodes({}, l),
	compare: m.layout_hub_compare({}, l),
	guides: m.nav_country_guides({}, l),
	"state-of-bch": m.nav_state_of_bch({}, l),
};
const segments = Astro.url.pathname
	.replace(/(\/index)?\.html$/, "")
	.split("/")
	.filter(Boolean);
const hub = segments.length === 2 ? hubs[segments[0]] : undefined;
const breadcrumbLd =
	hub && metadata.title && !/^\d+$/.test(segments[1])
		? {
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: m.nav_home({}, l),
						item: `${SITE.site}/`,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: hub,
						item: `${SITE.site}/${segments[0]}`,
					},
					{ "@type": "ListItem", position: 3, name: metadata.title },
				],
			}
		: undefined;
---

<!doctype html>
<html lang={lang ?? html.lang} dir={html.dir} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <slot name="head" />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}

  </head>

  <body class="antialiased font-sans text-default bg-page">
    <slot />

    <BasicScripts />

    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
