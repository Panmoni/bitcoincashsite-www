messages/en-XA.json
messages/ar-XB.json
messages/meta/en-XA.json
messages/meta/ar-XB.json
src/content/*/en-XA/
src/content/*/ar-XB/
src/data/i18n/en-XA/
src/data/i18n/ar-XB/
