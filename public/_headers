/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files. HTML keeps the Pages default (max-age=0, must-revalidate):
# the daily data rebuild must show up at once.
/favicon*
  Cache-Control: public, max-age=86400
/android-chrome-*
  Cache-Control: public, max-age=86400
/mstile-*
  Cache-Control: public, max-age=86400
/safari-pinned-tab.svg
  Cache-Control: public, max-age=86400
/panmoni.svg
  Cache-Control: public, max-age=86400
/files/*
  Cache-Control: public, max-age=86400
/tp4/*
  Cache-Control: public, max-age=86400
/bcmrs/*
  Cache-Control: public, max-age=300
/site.webmanifest
  Cache-Control: public, max-age=3600
/rss.xml
  Cache-Control: public, max-age=300
